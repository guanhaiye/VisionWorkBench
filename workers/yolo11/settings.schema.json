{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "YOLO11 推理设置",
  "type": "object",
  "properties": {
    "task": {
      "type": "string",
      "enum": ["detect", "instance", "semantic"],
      "default": "detect",
      "title": "任务类型",
      "description": "detect=目标定位；instance=实例分割；semantic=语义区域"
    },
    "modelPath": {
      "type": "string",
      "default": "models/yolo11n.pt",
      "title": "模型权重路径",
      "description": "相对于插件目录的 .pt/.onnx 等 Ultralytics 模型路径"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.25,
      "title": "置信度阈值"
    },
    "iou": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.7,
      "title": "NMS IoU 阈值"
    },
    "imageSize": {
      "type": "integer",
      "minimum": 32,
      "maximum": 4096,
      "default": 640,
      "title": "推理尺寸"
    },
    "maxDetections": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000,
      "default": 300,
      "title": "最大检测数"
    },
    "device": {
      "type": "string",
      "enum": ["auto", "cpu", "cuda", "cuda:0", "cuda:1"],
      "default": "auto",
      "title": "执行设备"
    },
    "half": {
      "type": "boolean",
      "default": false,
      "title": "FP16",
      "description": "仅 CUDA 设备启用"
    },
    "saveMasks": {
      "type": "boolean",
      "default": false,
      "title": "保存掩膜图"
    },
    "maskDirectory": {
      "type": "string",
      "default": "outputs/masks",
      "title": "掩膜输出目录"
    },
    "ignoredClassIds": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0 },
      "default": [],
      "title": "语义分割忽略类别"
    }
  }
}
