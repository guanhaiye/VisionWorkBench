<UserControl x:Class="VisionWorkbench.App.PluginsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="220" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,6">
            <Button Content="重新扫描" Click="Rescan_Click" />
            <TextBlock x:Name="PluginsRootText" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#666" />
        </DockPanel>
        <DataGrid x:Name="PluginsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="插件 ID" Binding="{Binding Id}" Width="220" />
                <DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="80" />
                <DataGridTextColumn Header="协议" Binding="{Binding ProtocolVersion}" Width="60" />
                <DataGridTextColumn Header="运行时" Binding="{Binding Runtime}" Width="90" />
                <DataGridTextColumn Header="能力" Binding="{Binding Capabilities}" Width="*" />
                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="130" />
            </DataGrid.Columns>
        </DataGrid>
        <GroupBox Grid.Row="2" Header="日志尾部（plugin-*.log）">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button Content="查看日志" Click="TailLog_Click" />
                    <TextBlock Text="选中上方插件后读取其日志最后 60 行（stderr 算法日志）"
                               VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#888" />
                </StackPanel>
                <TextBox x:Name="LogTail" Grid.Row="1" IsReadOnly="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="11" Margin="0,4,0,0" />
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
