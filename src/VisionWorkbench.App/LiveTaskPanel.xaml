<UserControl x:Class="VisionWorkbench.App.LiveTaskPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:VisionWorkbench.App"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch">
    <UserControl.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource PageTextBlockBaseStyle}" />
        <Style x:Key="InfoCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="MetricCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
    </UserControl.Resources>
        <Grid Margin="4" MinWidth="0" MinHeight="0" TextElement.Foreground="{DynamicResource TextBrush}"
          HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 状态文本由主窗口最底部的全局状态栏显示；保留隐藏元素供状态更新与日志监听。 -->
        <TextBlock x:Name="StatusText"
                   Grid.Row="0"
                   Visibility="Collapsed"
                   Text="相机 FPS: 0 | 算法 FPS: 0 | 后端：未连接" />

        <WrapPanel x:Name="ControlsPanel" Grid.Row="0" Margin="0,0,0,6">
            <TextBlock x:Name="TaskLabel" Text="任务 1：" VerticalAlignment="Center" Margin="0,0,0,4" />
            <ComboBox x:Name="TaskCombo" MinWidth="140" Width="220"
                      DisplayMemberPath="Name" Margin="6,0,4,0" SelectionChanged="TaskCombo_SelectionChanged" />
            <TextBlock x:Name="TaskModeText" Text="普通视觉检测" VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedTextBrush}" Margin="8,0,8,4" />
            <Button x:Name="StartButton" Content="开始" Click="Start_Click" Margin="4,0" Padding="10,3" />
            <Button x:Name="PauseButton" Content="暂停" Click="Pause_Click" IsEnabled="False" Padding="10,3" />
            <Button x:Name="SingleButton" Content="单次检测" Click="Single_Click" Padding="10,3" />
            <Button x:Name="StopButton" Content="结束批次" Click="Stop_Click" IsEnabled="False" Padding="10,3" />
            <Button x:Name="ResetCountButton" Content="清零" Click="ResetCount_Click" Padding="10,3" />
            <Button x:Name="RemoveButton" Content="移除任务" Click="Remove_Click" Margin="8,0,0,0" Padding="10,3" />
            <Button x:Name="RoiButton" Content="绘制检测区域" Click="Roi_Click" Margin="4,0,0,0" Padding="10,3" />
            <Button x:Name="ClearRoiButton" Content="清除区域" Click="ClearRoi_Click" IsEnabled="False" Margin="4,0,0,0" Padding="10,3" />
        </WrapPanel>

        <Grid x:Name="WorkspaceContentGrid" Grid.Row="1"
              PreviewMouseWheel="WorkspaceContentGrid_PreviewMouseWheel"
              SizeChanged="WorkspaceContentGrid_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1*" MinWidth="210" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#111111">
                <local:ImageViewer x:Name="PreviewViewer" WheelZoomEnabled="False">
                    <Grid x:Name="PreviewSurface"
                          MinWidth="1" MinHeight="1"
                          HorizontalAlignment="Left" VerticalAlignment="Top"
                          SizeChanged="PreviewSurface_SizeChanged"
                          PreviewMouseLeftButtonDown="PreviewSurface_MouseLeftButtonDown"
                          PreviewMouseMove="PreviewSurface_MouseMove"
                          PreviewMouseLeftButtonUp="PreviewSurface_MouseLeftButtonUp">
                        <Image x:Name="PreviewImage" Stretch="Uniform" />
                        <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False" />
                        <Canvas x:Name="RoiCanvas" IsHitTestVisible="False" />
                        <TextBlock x:Name="OfflineProgressText"
                                   Panel.ZIndex="10"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"
                                   Margin="10"
                                   Padding="8,4"
                                   Background="#CC111827"
                                   Foreground="White"
                                   FontSize="13"
                                   Visibility="Collapsed"
                                   Text="离线图片：0 / 0" />
                    </Grid>
                </local:ImageViewer>
            </Border>

            <ScrollViewer x:Name="DetailsScrollViewer" Grid.Column="1"
                          VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="6,0,0,0">
                <ScrollViewer.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="RemoveContextMenuItem"
                                  Header="删除任务"
                                  Click="RemoveFromContextMenu_Click" />
                    </ContextMenu>
                </ScrollViewer.ContextMenu>
                <StackPanel>
                    <Border x:Name="SopCard" Style="{StaticResource InfoCard}" Visibility="Collapsed">
                        <StackPanel>
                            <UniformGrid Columns="4" Margin="0,0,0,8">
                                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="7" Padding="7" Margin="0,0,3,0">
                                    <StackPanel>
                                        <TextBlock Text="当前步骤" Style="{StaticResource MetricCaption}" FontSize="16.5" />
                                        <TextBlock x:Name="SopMetricCurrentStep" Text="--" FontSize="18" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="7" Padding="7" Margin="3,0">
                                    <StackPanel>
                                        <TextBlock Text="已完成" Style="{StaticResource MetricCaption}" FontSize="16.5" />
                                        <TextBlock x:Name="SopMetricCompleted" Text="0 / 0" FontSize="24"
                                                   FontWeight="SemiBold" Margin="0,1,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="7" Padding="7" Margin="3,0">
                                    <StackPanel>
                                        <TextBlock Text="步骤耗时" Style="{StaticResource MetricCaption}" FontSize="16.5" />
                                        <TextBlock x:Name="SopMetricElapsed" Text="--" FontSize="18" FontWeight="SemiBold"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="7" Padding="7" Margin="3,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="异常" Style="{StaticResource MetricCaption}" FontSize="16.5" />
                                        <TextBlock x:Name="SopMetricExceptions" Text="0" FontSize="24"
                                                   FontWeight="SemiBold" Foreground="#C65D16" Margin="0,1,0,0" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="9" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="本轮外观质量检测" Style="{StaticResource CardTitle}" />
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="28" Height="28" Fill="#E87524" Margin="0,0,8,0" />
                                        <TextBlock x:Name="SopCurrentQualityText" Text="等待步骤确认"
                                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                                        <Border x:Name="SopCurrentQualityBadge" Background="#E87524"
                                                CornerRadius="5" Padding="7,3" Margin="8,0,0,0">
                                            <TextBlock x:Name="SopCurrentQualityBadgeText" Text="等待"
                                                       Foreground="White" FontSize="11" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="上一轮外观质量检测" Style="{StaticResource CardTitle}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="64" Height="48"
                                                Background="{DynamicResource SurfaceBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="4" HorizontalAlignment="Left">
                                            <Image x:Name="SopPreviousImage" Stretch="Uniform" Visibility="Collapsed" />
                                        </Border>
                                        <TextBlock x:Name="SopPreviousResultText" Grid.Column="1" Text="暂无上一轮结果"
                                                   VerticalAlignment="Center" TextWrapping="Wrap" Margin="4,0,0,0"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,8">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,7">
                                        <TextBlock Text="当前产品步骤" Style="{StaticResource CardTitle}" />
                                    </DockPanel>
                                    <ScrollViewer x:Name="SopStepsScrollViewer" MaxHeight="420"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  CanContentScroll="False">
                                        <ItemsControl x:Name="SopStepsItems">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="68" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Width="56" Height="56" CornerRadius="28"
                                                                Background="{Binding Brush}" HorizontalAlignment="Left">
                                                            <TextBlock Text="{Binding Indicator}" Foreground="White"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       FontSize="24" FontWeight="Bold" />
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" Margin="8,0,8,0" FontSize="24" />
                                                        <Border Grid.Column="2" Background="{Binding Brush}" CornerRadius="10"
                                                                Padding="12,6" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="22" />
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="StartNextSopButton" Content="开始下一件" Click="StartNextSop_Click"
                                        IsEnabled="False" Padding="9,3" />
                                <Button x:Name="ResetSopButton" Content="复位当前产品" Click="ResetSop_Click"
                                        IsEnabled="False" Padding="9,3" />
                                <TextBlock x:Name="SopCurrentStepText" Text="等待开始" Visibility="Collapsed" />
                                <TextBlock x:Name="SopCycleText" Text="" Foreground="{DynamicResource MutedTextBrush}"
                                           VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border x:Name="DecisionCard" Style="{StaticResource InfoCard}">
                        <StackPanel>
                            <TextBlock Text="当前判定" Style="{StaticResource CardTitle}" />
                            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Padding="8" Margin="0,0,0,8">
                                <TextBlock x:Name="DecisionText" Text="-" FontSize="30" FontWeight="Bold"
                                           HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                            </Border>
                            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="ResultCard" Style="{StaticResource InfoCard}">
                        <StackPanel>
                            <TextBlock Text="检测结果" Style="{StaticResource CardTitle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="本帧数量" Style="{StaticResource MetricCaption}" />
                                    <TextBlock x:Name="CountText" Text="数量：-" Style="{StaticResource MetricValue}" Margin="0,2,4,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="处理耗时" Style="{StaticResource MetricCaption}" />
                                    <TextBlock x:Name="ElapsedText" Text="算法耗时：-" FontSize="12"
                                               Foreground="{DynamicResource TextBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border x:Name="StatsCard" Style="{StaticResource InfoCard}">
                        <StackPanel>
                            <TextBlock Text="累计统计" Style="{StaticResource CardTitle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="累计总数" Style="{StaticResource MetricCaption}" />
                                    <TextBlock x:Name="TotalText" Text="累计：0" Style="{StaticResource MetricValue}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0">
                                    <TextBlock Text="OK" Style="{StaticResource MetricCaption}" />
                                    <TextBlock x:Name="OkCountText" Text="OK：0" Style="{StaticResource MetricValue}" Foreground="#16803C" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                    <TextBlock Text="NG" Style="{StaticResource MetricCaption}" />
                                    <TextBlock x:Name="NgCountText" Text="NG：0" Style="{StaticResource MetricValue}" Foreground="#C62828" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="BatchText" Text="批次：-" FontSize="11"
                                       Foreground="{DynamicResource MutedTextBrush}" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="LogCard" Style="{StaticResource InfoCard}">
                        <StackPanel>
                            <TextBlock Text="检测日志（最近 100 条）" Style="{StaticResource CardTitle}" />
                            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6" Padding="8">
                                <ScrollViewer x:Name="DetectionLogScrollViewer" Height="150"
                                              VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="DetectionListText" Text="暂无检测记录" TextWrapping="Wrap"
                                               FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

    </Grid>
</UserControl>
