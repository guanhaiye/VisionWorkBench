<UserControl x:Class="VisionWorkbench.App.SopRecordingPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VisionWorkbench.App"
        Loaded="Control_Loaded" Unloaded="Control_Unloaded">
    <UserControl.Resources>
        <Style x:Key="SopDataGridCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="SopDataGridHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="SopDataGridTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource PageTextBlockBaseStyle}">
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SopDataGridTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="VideoIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock Text="模式" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="RecordModeCombo" Width="115" SelectedIndex="0"
                          SelectionChanged="RecordModeCombo_SelectionChanged">
                    <ComboBoxItem Content="自动模式" />
                    <ComboBoxItem Content="手动模式" />
                </ComboBox>
                <TextBlock Text="相机" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="CameraCombo" DisplayMemberPath="DisplayName" Width="220" />
                <Button Content="刷新相机" Click="RefreshCamera_Click" Margin="6,2,0,2" Padding="12,5" />
                <TextBlock Text="准备倒计时（秒）" VerticalAlignment="Center" Margin="18,0,6,0" />
                <TextBox x:Name="PreparationSecondsText" Text="3" Width="55" />
                <Button x:Name="RecordToggleButton" Content="开始录制" Click="RecordToggleButton_Click"
                        Margin="14,2,0,2" Padding="18,5" />
            </StackPanel>
            <Button Content="返回 SOP 配置" Click="Back_Click" DockPanel.Dock="Left"
                    Margin="0,2,12,2" Padding="16,5" Style="{StaticResource SecondaryButton}" />
            <StackPanel>
                <TextBlock Text="SOP视频录制" FontSize="24" FontWeight="SemiBold" />
                <TextBlock x:Name="SopNameText" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="370" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="录制步骤">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="添加步骤" Click="AddStep_Click" Padding="12,5" />
                        <Button Content="删除步骤" Click="RemoveStep_Click" Margin="6,2,0,2" Padding="12,5" />
                        <TextBlock x:Name="TotalDurationText" VerticalAlignment="Center" Margin="14,0,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>
                    <DataGrid x:Name="StepGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                              SelectionMode="Single" MinHeight="260"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              CellStyle="{StaticResource SopDataGridCellStyle}"
                              ColumnHeaderStyle="{StaticResource SopDataGridHeaderStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="序号" Binding="{Binding Order}" Width="55"
                                                ElementStyle="{StaticResource SopDataGridTextBlockStyle}" />
                            <DataGridTextColumn Header="动作步骤" Binding="{Binding Name, UpdateSourceTrigger=LostFocus}" Width="*"
                                                ElementStyle="{StaticResource SopDataGridTextBlockStyle}"
                                                EditingElementStyle="{StaticResource SopDataGridTextBoxStyle}" />
                            <DataGridTextColumn Header="持续时间（秒）" Binding="{Binding DurationText, UpdateSourceTrigger=LostFocus}" Width="115"
                                                ElementStyle="{StaticResource SopDataGridTextBlockStyle}"
                                                EditingElementStyle="{StaticResource SopDataGridTextBoxStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Text="录制时会按列表顺序提示动作，持续时间结束后自动进入下一步。"
                               Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                </Grid>
            </GroupBox>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="230" MinHeight="180" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{DynamicResource AccentSoftBrush}" CornerRadius="7"
                        Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock x:Name="StepPromptText" Text="请在左侧添加录制步骤" FontSize="22" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" TextAlignment="Center" />
                        <TextBlock x:Name="CountdownText" Foreground="{DynamicResource AccentBrush}" FontSize="16" Margin="0,6,0,0"
                                   HorizontalAlignment="Center" TextAlignment="Center">
                            <Run x:Name="CountdownPlainRun" />
                            <Run x:Name="CountdownRemainingPrefixRun" />
                            <Run x:Name="CountdownRemainingValueRun" FontSize="24" FontWeight="Bold" />
                            <Run x:Name="CountdownRemainingUnitRun" FontSize="24" FontWeight="Bold" />
                        </TextBlock>
                        <TextBlock x:Name="RecordStatusText" Text="选择相机后点击“开始录制”" Foreground="{DynamicResource MutedTextBrush}" Margin="0,6,0,0"
                                   HorizontalAlignment="Center" TextAlignment="Center" />
                        <TextBlock x:Name="VideoStatusText" Text="" Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,6,0,0" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" TextAlignment="Center" />
                        <Button x:Name="ManualStepButton" Content="开始当前步骤" Click="ManualStepButton_Click"
                                Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,8,0,0" Padding="18,6" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Background="#111111" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <local:ImageViewer Background="#111111">
                            <Image x:Name="PreviewImage" Stretch="Uniform" />
                        </local:ImageViewer>
                        <MediaElement x:Name="VideoPlayer" Visibility="Collapsed"
                                      LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform"
                                      MediaOpened="VideoPlayer_MediaOpened" MediaEnded="VideoPlayer_MediaEnded" />
                        <Border x:Name="PreparationOverlay" Panel.ZIndex="3" Visibility="Collapsed"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="#881F2937" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="7" Padding="18">
                            <StackPanel>
                                <TextBlock x:Name="PreparationPromptText" FontSize="22" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" TextAlignment="Center" />
                                <TextBlock x:Name="PreparationCountdownText" Foreground="{DynamicResource AccentBrush}"
                                           FontSize="16" Margin="0,6,0,0"
                                           HorizontalAlignment="Center" TextAlignment="Center">
                                    <Run x:Name="PreparationCountdownNumberRun" FontSize="24" FontWeight="Bold" />
                                    <Run Text=" " />
                                    <Run Text="秒" FontSize="24" FontWeight="Bold" />
                                    <Run Text="后" />
                                    <Run Text="开始" />
                                </TextBlock>
                                </StackPanel>
                            </Border>
                        <Border x:Name="VideoPlaybackControls" Panel.ZIndex="4" Visibility="Collapsed"
                                VerticalAlignment="Bottom" Margin="10" Padding="10,7"
                                Background="#DD111111" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="VideoCurrentTimeText" Text="00:00" VerticalAlignment="Center"
                                           Margin="0,0,8,0" Foreground="{DynamicResource MutedTextBrush}" />
                                <Slider x:Name="VideoProgressSlider" Grid.Column="1" Minimum="0" Maximum="1"
                                        Value="0" IsMoveToPointEnabled="True" VerticalAlignment="Center"
                                        PreviewMouseLeftButtonDown="VideoProgressSlider_MouseLeftButtonDown"
                                        PreviewMouseLeftButtonUp="VideoProgressSlider_MouseLeftButtonUp"
                                        ValueChanged="VideoProgressSlider_ValueChanged" />
                                <TextBlock x:Name="VideoDurationText" Grid.Column="2" Text="00:00" VerticalAlignment="Center"
                                           Margin="8,0,0,0" Foreground="{DynamicResource MutedTextBrush}" />
                                <Button x:Name="VideoPlayPauseButton" Grid.Column="3" Style="{StaticResource VideoIconButtonStyle}"
                                        Click="VideoPlayPause_Click" ToolTip="播放" Width="44" Height="44"
                                        MinWidth="0" MinHeight="0" Margin="8,0,2,0" Padding="0"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                    <Grid Width="22" Height="22">
                                        <Polygon x:Name="VideoPlayGlyph" Points="3,1 20,11 3,21"
                                                 Fill="White" Visibility="Collapsed" />
                                        <StackPanel x:Name="VideoPauseGlyph" Orientation="Horizontal"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Rectangle Width="6" Height="20" Fill="White" Margin="0,0,4,0" />
                                            <Rectangle Width="6" Height="20" Fill="White" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Button x:Name="VideoStopButton" Grid.Column="4" Style="{StaticResource VideoIconButtonStyle}"
                                        Click="VideoStop_Click" ToolTip="停止" Width="44" Height="44"
                                        MinWidth="0" MinHeight="0" Margin="2,0,0,0" Padding="0"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                    <Rectangle Width="20" Height="20" Fill="White" />
                                </Button>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="PreviewHintText" Text="选择相机后点击“开始录制”" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <GroupBox Grid.Row="2" Header="已录制视频与检查" Margin="0,10,0,0">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ListBox x:Name="VideoList" Grid.Row="1" DisplayMemberPath="DisplayName"
                                 SelectionChanged="VideoList_SelectionChanged"
                                 PreviewMouseLeftButtonDown="VideoList_PreviewMouseLeftButtonDown"
                                 PreviewMouseLeftButtonUp="VideoList_PreviewMouseLeftButtonUp"
                                 ContextMenuOpening="VideoList_ContextMenuOpening">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="打开所在目录" Click="OpenVideoFolder_Click" />
                                    <MenuItem Header="删除视频" Click="DeleteVideo_Click" />
                                    <MenuItem Header="清空视频" Click="ClearVideos_Click" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>
                    </Grid>
                </GroupBox>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
