<UserControl x:Class="VisionWorkbench.App.ModelTestPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:VisionWorkbench.App">
    <UserControl.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource PageTextBlockBaseStyle}" />
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="测试平台" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="模型：" VerticalAlignment="Center"/>
            <ComboBox x:Name="ModelCombo" Width="360" DisplayMemberPath="DisplayName"
                      SelectionChanged="ModelCombo_SelectionChanged"
                      ToolTip="选择训练平台中已完成的模型节点"/>
            <!-- 保留为测试服务的内部路径，不再让用户直接编辑。 -->
            <TextBox x:Name="ModelPathText" Visibility="Collapsed" IsReadOnly="True"/>
            <Button Content="选择模型" Click="BrowseModel_Click"/>
            <Button Content="选择图片" Click="BrowseImage_Click"/>
            <Button Content="选择图片目录" Click="BrowseFolder_Click"/>
            <StackPanel x:Name="DetectionOptionsPanel" Orientation="Horizontal" Margin="12,0,0,0">
                <TextBlock Text="置信度" Margin="0,0,4,0" VerticalAlignment="Center"/>
                <TextBox x:Name="ConfidenceText" Text="0.25" Width="60" TextAlignment="Center"/>
                <TextBlock Text="IoU" Margin="10,0,4,0" VerticalAlignment="Center"/>
                <TextBox x:Name="IouText" Text="0.70" Width="60" TextAlignment="Center"/>
            </StackPanel>
            <ComboBox x:Name="DeviceCombo" Width="100" SelectedIndex="0">
                <ComboBoxItem Content="自动" Tag="auto"/>
                <ComboBoxItem Content="CPU" Tag="cpu"/>
                <ComboBoxItem Content="CUDA 0" Tag="0"/>
            </ComboBox>
            <Button x:Name="RunButton" Content="开始测试" Click="Run_Click"/>
            <StackPanel x:Name="SemanticOptionsPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="12,0,0,0">
                <TextBlock Text="语义类别与尺寸：模型内置" VerticalAlignment="Center" Margin="0,0,4,0"/>
            </StackPanel>
        </WrapPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
            <ListBox x:Name="ImageList" SelectionChanged="ImageList_SelectionChanged" DisplayMemberPath="FileName" Margin="0,0,10,0"/>
            <local:ImageViewer x:Name="PreviewViewer" Grid.Column="1" Background="#202020" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Image x:Name="PreviewImage" Stretch="Uniform"/>
                    <Canvas x:Name="OverlayCanvas" Background="Transparent" SizeChanged="OverlayCanvas_SizeChanged"/>
                </Grid>
            </local:ImageViewer>
            <StackPanel Grid.Column="2" Margin="10,0,0,0">
                <TextBlock x:Name="TaskTypeText" Text="模型类型：未识别" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <ListBox x:Name="ResultList"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="3" BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="4" Margin="0,8,0,0">
            <TextBlock x:Name="StatusText" Foreground="DarkGreen" TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
