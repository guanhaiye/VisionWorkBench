<UserControl x:Class="VisionWorkbench.App.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource PageTextBlockBaseStyle}" />
    </UserControl.Resources>
    <ScrollViewer x:Name="SettingsScrollViewer"
                  PreviewMouseWheel="SettingsScrollViewer_PreviewMouseWheel">
        <StackPanel Margin="12" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="系统设置" FontSize="18" FontWeight="Bold" Margin="0,0,0,12" />

            <GroupBox Header="数据目录（APP-003：支持中文与空格路径；重启后生效）">
                <StackPanel>
                    <TextBox x:Name="DataDirText" Margin="0,4,0,4" LostFocus="AutoSaveTextBox_LostFocus" />
                    <TextBlock Text="数据库、证据图、日志、临时图都保存在此目录下。" Foreground="#888" FontSize="11" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="SOP 采集数据目录（自动保存）" Margin="0,8,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="SopRecordingDirText" Margin="0,4,8,4" MinWidth="420"
                                 LostFocus="AutoSaveTextBox_LostFocus" />
                        <Button Content="选择目录" Click="BrowseSopRecordingDirectory_Click" Margin="0,4,0,4" />
                    </StackPanel>
                    <TextBlock Text="录制视频、原始帧、分步骤视频和 manifest.json 将保存到此目录；修改后新录制立即使用。"
                               Foreground="#888" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="日志保存等级">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="保存等级：" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox x:Name="LogPersistenceLevelCombo" Width="220" HorizontalContentAlignment="Center"
                              SelectionChanged="AutoSaveSelectionChanged">
                        <ComboBoxItem Content="所有" Tag="All" />
                        <ComboBoxItem Content="严重以上" Tag="CriticalAndAbove" />
                        <ComboBoxItem Content="一般以上" Tag="InformationAndAbove" />
                        <ComboBoxItem Content="警告以上" Tag="WarningAndAbove" />
                        <ComboBoxItem Content="都不保存" Tag="None" />
                    </ComboBox>
                    <TextBlock Text="只影响后续写入的日志" Foreground="{DynamicResource MutedTextBrush}"
                               VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="标注数据集目录">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="DatasetDirText" Margin="0,4,8,4" MinWidth="420"
                                 LostFocus="AutoSaveTextBox_LostFocus" />
                        <Button Content="选择目录" Click="BrowseDatasetDirectory_Click" Margin="0,4,0,4" />
                    </StackPanel>
                    <TextBlock Text="标注平台读取原始图片后，会复制到此目录下的新数据集目录，不会修改原始图片目录。默认：E:\。"
                               Foreground="#888" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Python 解释器（开发态；打包态用插件内嵌 runtime）" Visibility="Collapsed">
                <StackPanel>
                    <TextBox x:Name="PythonText" Margin="0,4,0,4" />
                    <TextBlock Text="留空 = 自动探测 workers/.venv/Scripts/python.exe；写入 PYTHONIOENCODING=utf-8 启动 Worker。"
                               Foreground="#888" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="插件根目录（重启后生效）" Visibility="Collapsed">
                <TextBox x:Name="PluginsRootText2" Margin="0,4,0,4" />
            </GroupBox>

            <GroupBox Header="执行后端（CPU 保底，文档 §19）" Visibility="Collapsed">
                <ComboBox x:Name="BackendCombo" Width="200" HorizontalAlignment="Left">
                    <ComboBoxItem Content="cpu" IsSelected="True" />
                    <ComboBoxItem Content="cuda" />
                    <ComboBoxItem Content="openvino" />
                </ComboBox>
            </GroupBox>

            <GroupBox Header="检测数据记录">
                <StackPanel>
                    <CheckBox x:Name="EnableHistoryCheck" Content="开启历史记录" IsChecked="True"
                              Checked="AutoSaveSetting_Changed" Unchecked="AutoSaveSetting_Changed"
                              Margin="0,4,0,2" />
                    <TextBlock Text="关闭后不再在历史记录页面显示新产生的检测记录。"
                               Foreground="#888" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="界面主题（立即生效）">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="右侧页面颜色风格：" Margin="0,0,10,0"/>
                    <ComboBox x:Name="ThemeCombo" Width="180" SelectionChanged="AutoSaveSelectionChanged">
                        <ComboBoxItem Content="日间模式" Tag="light"/>
                        <ComboBoxItem Content="夜间模式" Tag="dark"/>
                    </ComboBox>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="全局字体大小（保存后立即生效）">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="界面缩放比例：" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <ComboBox x:Name="UiScaleCombo" Width="200" HorizontalContentAlignment="Center"
                              SelectionChanged="AutoSaveSelectionChanged">
                        <ComboBoxItem Content="较小（80%）" Tag="0.8"/>
                        <ComboBoxItem Content="小（90%）" Tag="0.9"/>
                        <ComboBoxItem Content="标准（100%）" Tag="1.0"/>
                        <ComboBoxItem Content="大（110%）" Tag="1.1"/>
                        <ComboBoxItem Content="较大（125%）" Tag="1.25"/>
                        <ComboBoxItem Content="特大（150%）" Tag="1.5"/>
                    </ComboBox>
                    <TextBlock Text="全局文字将同比缩放" Margin="12,0,0,0"
                               Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="参数自动备份">
                <StackPanel Margin="0,4,0,2">
                    <CheckBox x:Name="AutomaticBackupCheck" Content="启用自动备份"
                              Checked="AutoSaveSetting_Changed" Unchecked="AutoSaveSetting_Changed"
                              Margin="0,0,0,8" />
                    <WrapPanel Margin="0,0,0,6" VerticalAlignment="Top">
                        <TextBlock Text="备份频率：" VerticalAlignment="Center" />
                        <ComboBox x:Name="AutomaticBackupIntervalCombo" Width="130" Height="36" Margin="0,0,16,0"
                                  SelectionChanged="AutoSaveSelectionChanged">
                            <ComboBoxItem Content="每天" Tag="1440" />
                            <ComboBoxItem Content="每周" Tag="10080" />
                            <ComboBoxItem Content="每月" Tag="43200" />
                        </ComboBox>
                        <TextBlock Text="保留版本：" VerticalAlignment="Center" />
                        <ComboBox x:Name="AutomaticBackupRetentionCombo" Width="100" Height="36"
                                  SelectionChanged="AutoSaveSelectionChanged">
                            <ComboBoxItem Content="5 个" Tag="5" />
                            <ComboBoxItem Content="10 个" Tag="10" />
                            <ComboBoxItem Content="30 个" Tag="30" />
                            <ComboBoxItem Content="60 个" Tag="60" />
                            <ComboBoxItem Content="365 个" Tag="365" />
                        </ComboBox>
                    </WrapPanel>
                    <TextBlock x:Name="BackupScheduleText" Margin="0,2,0,10"
                               MinHeight="34" VerticalAlignment="Top"
                               Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="备份设置会在修改后自动保存。"
                               Margin="0,0,0,6" VerticalAlignment="Top"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <WrapPanel Margin="0,0,0,8" VerticalAlignment="Top">
                        <Button Content="立即备份" Click="CreateLocalBackup_Click" MinWidth="100" />
                        <Button Content="刷新版本" Click="RefreshBackups_Click" MinWidth="90" />
                        <Button Content="打开备份目录" Click="OpenBackupDirectory_Click" MinWidth="120" />
                    </WrapPanel>
                    <TextBlock Text="可恢复版本（按备份日期倒序）：" Margin="0,0,0,6"
                               VerticalAlignment="Top" />
                    <ListBox x:Name="BackupVersionsList" Height="150" DisplayMemberPath="DisplayText"
                             Margin="0,0,0,2" />
                    <Button Content="恢复选中版本" Click="RestoreSelectedBackup_Click" HorizontalAlignment="Left"
                            MinWidth="120" Margin="0,8,0,0" />
                    <TextBlock x:Name="BackupHintText" Margin="0,6,0,0" MinHeight="24"
                               VerticalAlignment="Top" TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="角色与操作者（v1 免密切换——已知限制 #8）">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="角色：" VerticalAlignment="Center" />
                    <ComboBox x:Name="RoleCombo" Width="140" IsEnabled="False" ToolTip="请在用户管理中维护角色">
                        <ComboBoxItem Content="超级管理员" Tag="admin" />
                        <ComboBoxItem Content="操作员" Tag="operator" />
                        <ComboBoxItem Content="工程师" Tag="engineer" />
                        <ComboBoxItem Content="专家" Tag="expert" />
                    </ComboBox>
                    <TextBlock Text="操作者姓名：" VerticalAlignment="Center" Margin="24,0,8,0" />
                    <TextBox x:Name="OperatorNameText" Width="160" IsReadOnly="True"
                             ToolTip="请在用户管理中维护账号" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="软件授权（离线签名校验）">
                <StackPanel>
                    <TextBlock x:Name="LicenseStatusText" TextWrapping="Wrap" />
                    <Button Content="导入许可证" Click="ImportLicense_Click" HorizontalAlignment="Left"
                            MinWidth="110" Margin="0,8,0,0" />
                </StackPanel>
            </GroupBox>

            <TextBlock x:Name="SaveHintText" Text="设置修改后自动保存。"
                       Margin="0,12,0,0" Foreground="{DynamicResource MutedTextBrush}" />

            <GroupBox Header="数据库与诊断" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text=".vwbackup 包含数据库、配置和受支持的元数据，自动校验哈希；默认不包含原始/证据图片。恢复会覆盖当前数据库并需要重新启动应用。"
                               Foreground="#888" FontSize="11" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="创建完整备份" Click="Backup_Click" MinWidth="110" />
                        <Button Content="恢复完整备份" Click="Restore_Click" MinWidth="110" Margin="8,0,0,0" />
                        <Button Content="导出诊断包" Click="Diagnostics_Click" MinWidth="110" Margin="8,0,0,0" />
                        <Button Content="一键自检" Click="SelfCheck_Click" MinWidth="90" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="SelfCheckText" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
