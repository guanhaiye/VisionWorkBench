<Window x:Class="VisionWorkbench.App.PythonScriptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Python 后处理脚本" Width="920" Height="680"
        Style="{StaticResource ThemedDialogWindow}"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            CornerRadius="10" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Python 后处理脚本" FontSize="20" FontWeight="SemiBold" />
            <StackPanel Grid.Row="1" Margin="0,8,0,12">
                <TextBlock Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap">
                    <Run Text="固定脚本接口：输入变量 " />
                    <Run Text="input_data" FontFamily="Consolas" FontWeight="SemiBold" />
                    <Run Text="，输出变量 " />
                    <Run Text="result" FontFamily="Consolas" FontWeight="SemiBold" />
                    <Run Text="。变量名不能修改，内部变量可以自由定义。" />
                </TextBlock>
                <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap">
                    <Run Text="input_data 包含 schemaVersion、taskType、image、items 和 raw；items 是当前任务统一的对象列表，result 只能设置 keepIndices、status 和 message。status 使用 ok 或 ng。" />
                </TextBlock>
            </StackPanel>
            <TextBox x:Name="ScriptTextBox" Grid.Row="2" AcceptsReturn="True"
                     TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" FontFamily="Consolas"
                     FontSize="13" Padding="10" SpellCheck.IsEnabled="False" />
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="取消" IsCancel="True" Width="90" />
                <Button Content="保存脚本" IsDefault="True" Click="Save_Click"
                        Width="110" Margin="10,0,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
