<UserControl x:Class="VisionWorkbench.App.BehaviorCollectionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:VisionWorkbench.App"
             Loaded="Page_Loaded" Unloaded="Page_Unloaded">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
            <Button Content="&#x65B0;&#x5EFA;&#x884C;&#x4E3A;&#x6570;&#x636E;&#x96C6;" Click="NewDataset_Click" Padding="12,5" />
            <Button Content="&#x52A0;&#x8F7D;&#x6570;&#x636E;&#x96C6;" Click="LoadDataset_Click" Margin="6,0,0,0" Padding="12,5" />
            <Button Content="&#x5BFC;&#x5165;&#x89C6;&#x9891;" Click="ImportVideo_Click" Margin="6,0,0,0" Padding="12,5" />
            <Button Content="&#x5BFC;&#x5165;&#x56FE;&#x7247;&#x5E8F;&#x5217;" Click="ImportFrames_Click" Margin="6,0,0,0" Padding="12,5" />
            <Button Content="&#x6253;&#x5F00;&#x6570;&#x636E;&#x96C6;&#x76EE;&#x5F55;" Click="OpenDirectory_Click" Margin="6,0,0,0" Padding="12,5" />
        </WrapPanel>
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
            <GroupBox Header="&#x6570;&#x636E;&#x96C6;" Margin="0,0,8,0">
                <StackPanel Margin="8">
                    <TextBlock Text="&#x540D;&#x79F0;" />
                    <TextBox x:Name="DatasetNameText" Margin="0,2,0,5" />
                    <TextBlock Text="&#x6839;&#x76EE;&#x5F55;" />
                    <TextBox x:Name="DatasetRootText" IsReadOnly="True" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
            </GroupBox>
            <GroupBox Grid.Column="1" Header="&#x91C7;&#x96C6;&#x8BBE;&#x7F6E;" Margin="0,0,8,0">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="&#x76F8;&#x673A;" VerticalAlignment="Center" Margin="0,0,8,4" />
                    <ComboBox x:Name="CameraCombo" Grid.Column="1" DisplayMemberPath="DisplayName" SelectionChanged="CameraCombo_SelectionChanged" Margin="0,0,6,4" />
                    <Button Grid.Column="2" Content="&#x5237;&#x65B0;" Click="RefreshCamera_Click" Padding="10,3" />
                    <TextBlock Grid.Row="1" Text="&#x91C7;&#x96C6;&#x5E27;&#x7387;" VerticalAlignment="Center" Margin="0,0,8,4" />
                    <ComboBox x:Name="FpsCombo" Grid.Row="1" Grid.Column="1" SelectedIndex="1" Margin="0,0,6,4">
                        <ComboBoxItem Content="5 FPS" Tag="5" /><ComboBoxItem Content="10 FPS" Tag="10" /><ComboBoxItem Content="15 FPS" Tag="15" />
                    </ComboBox>
                    <TextBlock Grid.Row="2" Text="&#x91C7;&#x96C6;&#x65F6;&#x957F;&#xFF08;&#x79D2;&#xFF09;" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox x:Name="DurationText" Grid.Row="2" Grid.Column="1" Text="0" ToolTip="0 &#x8868;&#x793A;&#x624B;&#x52A8;&#x505C;&#x6B62;" />
                </Grid>
            </GroupBox>
            <GroupBox Grid.Column="2" Header="&#x91C7;&#x96C6;&#x72B6;&#x6001;">
                <StackPanel Margin="8">
                    <TextBlock x:Name="CameraStatusText" Text="&#x672A;&#x9009;&#x62E9;&#x76F8;&#x673A;" TextWrapping="Wrap" />
                    <TextBlock x:Name="RecordStatusText" Text="&#x672A;&#x5F55;&#x5236;" Margin="0,6,0,0" />
                    <WrapPanel Margin="0,8,0,0">
                        <Button x:Name="RecordButton" Content="&#x5F00;&#x59CB;&#x5F55;&#x5236;" Click="RecordButton_Click" Padding="12,4" />
                        <Button Content="&#x5F00;&#x59CB;&#x9884;&#x89C8;" Click="StartPreview_Click" Margin="6,0,0,0" Padding="12,4" />
                        <Button Content="&#x505C;&#x6B62;&#x9884;&#x89C8;" Click="StopPreview_Click" Margin="6,0,0,0" Padding="12,4" />
                    </WrapPanel>
                </StackPanel>
            </GroupBox>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <GroupBox Header="&#x5DF2;&#x91C7;&#x96C6;&#x6765;&#x6E90;" Margin="0,0,8,0">
                <ListBox x:Name="SourceList" DisplayMemberPath="DisplayName" SelectionChanged="SourceList_SelectionChanged" PreviewMouseRightButtonDown="SourceList_PreviewMouseRightButtonDown" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="删除当前来源" Click="DeleteSource_Click" />
                            <MenuItem Header="清空全部来源" Click="ClearSources_Click" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </GroupBox>
            <GroupBox Grid.Column="1" Header="&#x76F8;&#x673A;&#x9884;&#x89C8;">
                <local:ImageViewer Background="#202020">
                    <Grid>
                        <Image x:Name="PreviewImage" Stretch="Uniform" />
                        <TextBlock x:Name="PreviewHintText" Text="&#x8BF7;&#x9009;&#x62E9;&#x76F8;&#x673A;" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" />
                        <Border Background="#DD202020" VerticalAlignment="Bottom" Padding="8" Panel.ZIndex="2">
                            <StackPanel>
                                <TextBlock x:Name="PlaybackStatusText" Text="选择已采集来源后可播放" Foreground="White" Margin="0,0,0,4" />
                                <DockPanel>
                                    <Button Content="播放" Click="PlaybackPlay_Click" Padding="10,3" />
                                    <Button Content="暂停" Click="PlaybackPause_Click" Margin="6,0,0,0" Padding="10,3" />
                                    <Button Content="停止" Click="PlaybackStop_Click" Margin="6,0,8,0" Padding="10,3" />
                                    <Slider x:Name="PlaybackSlider" Minimum="0" Value="0" VerticalAlignment="Center" IsEnabled="False" ValueChanged="PlaybackSlider_ValueChanged" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </local:ImageViewer>
            </GroupBox>
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="3" Foreground="DarkGreen" Margin="0,8,0,0" TextWrapping="Wrap" />
    </Grid>
</UserControl>
