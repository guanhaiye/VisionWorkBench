<Window x:Class="VisionWorkbench.App.PythonScriptRulesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Python&#x811A;&#x672C;&#x7F16;&#x5199;&#x89C4;&#x5219;" Width="920" Height="720"
        Style="{StaticResource ThemedDialogWindow}"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            CornerRadius="10" Padding="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Python&#x811A;&#x672C;&#x7F16;&#x5199;&#x89C4;&#x5219;" FontSize="21" FontWeight="SemiBold" />
                <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource MutedTextBrush}"
                           Text="&#x4EFB;&#x52A1;&#x914D;&#x7F6E;&#x4E2D;&#x7684;&#x540E;&#x5904;&#x7406;&#x811A;&#x672C;&#x7528;&#x4E8E;&#x5BF9;&#x6A21;&#x578B;&#x7ED3;&#x679C;&#x8FDB;&#x884C;&#x4E8C;&#x6B21;&#x7B5B;&#x9009;&#x3002;&#x811A;&#x672C;&#x53EA;&#x9700;&#x8BFB;&#x53D6;&#x56FA;&#x5B9A;&#x8F93;&#x5165;&#x5E76;&#x8BBE;&#x7F6E;&#x56FA;&#x5B9A;&#x8F93;&#x51FA;&#x3002;" TextWrapping="Wrap" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" Margin="0,16,0,14"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="1. 固定接口" FontSize="16" FontWeight="SemiBold" />
                    <Border Margin="0,8,0,14" Padding="12" Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}">
                            <Run Text="输入变量必须使用 " />
                            <Run Text="input_data" FontFamily="Consolas" FontWeight="SemiBold" />
                            <Run Text="；输出变量必须使用 " />
                            <Run Text="result" FontFamily="Consolas" FontWeight="SemiBold" />
                            <Run Text="。变量名不能修改，脚本中的其他内部变量可以自由定义。" />
                        </TextBlock>
                    </Border>

                    <TextBlock Text="2. input_data 输入结构" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Margin="0,7,0,4" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                               Text="通用字段：schemaVersion、taskType、imagePath、imageWidth、imageHeight、items、raw。最常用的是 items，它是当前任务结果对象列表；taskType 用于区分目标检测、语义分割、实例分割和行为识别。" />
                    <Border Margin="0,5,0,14" Padding="12" Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                        <TextBlock FontFamily="Consolas" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}">
                            <Run Text="目标检测：kind, index, classId, className, confidence, areaPx, diameterPx, box&#xA;" />
                            <Run Text="语义/实例分割：kind=segmentation, index, mode, classId, confidence, areaPx, diameterPx, contours&#xA;" />
                            <Run Text="行为识别：kind=behaviorEvent, index, eventId, eventType, phase, severity, confidence, durationMs" />
                        </TextBlock>
                    </Border>

                    <TextBlock Text="3. result 输出结构" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Margin="0,7,0,4" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                               Text="result 必须是 JSON 对象，并且必须包含 status。平台只接受以下字段：keepIndices、status、message。keepIndices 是保留对象的原始 index 数组；status 只能填写 ok 或 ng；message 为可选说明。" />
                    <Border Margin="0,5,0,14" Padding="12" Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                        <TextBlock FontFamily="Consolas" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"><Run Text="result = {&#xA;    &quot;keepIndices&quot;: [0, 2],&#xA;    &quot;status&quot;: &quot;ok&quot;,&#xA;    &quot;message&quot;: &quot;保留 2 个对象&quot;&#xA;}" /></TextBlock>
                    </Border>

                    <TextBlock Text="4. 编写注意事项" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Margin="0,7,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                               Text="• 面积和直径使用像素值 areaPx、diameterPx，不是归一化数值。&#xA;• keepIndices 必须使用 items 中的 index，不要使用循环位置猜测。&#xA;• 筛选后仍有对象通常判为 OK；没有保留对象时应返回 NG。&#xA;• 行为识别没有面积字段，应根据 eventType、severity、durationMs 等事件字段编写规则。&#xA;• 脚本执行失败或输出字段不符合约定时，平台会将本次结果判为 NG 并记录错误。" />
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="关闭" IsCancel="True" Width="90" Style="{StaticResource SecondaryButton}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
