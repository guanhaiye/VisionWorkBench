<Window x:Class="VisionWorkbench.App.Shell"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VisionWorkbench &#x2014; AI &#x89C6;&#x89C9;&#x5DE5;&#x4F5C;&#x53F0;" Width="1280" Height="800"
        WindowStartupLocation="CenterScreen">
    <Window.Icon>
        <BitmapImage UriSource="/Assets/Branding/visionworkbench-taskbar.ico" />
    </Window.Icon>
    <Window.Resources>
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="#DCE8FF" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="SidebarListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#E8E8E8" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A3D49" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1769AA" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#292A32">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <Image Source="/Assets/Branding/visionworkbench-logo-v1.png"
                           Width="82" Height="82" Stretch="Uniform" HorizontalAlignment="Center"
                           Margin="0,14,0,2" />
                    <TextBlock Text="VisionWorkbench" Foreground="White" FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="8,2,8,14" />
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Expander Header="&#x5DE5;&#x4F5C;&#x53F0;" IsExpanded="False">
                            <ListBox ItemContainerStyle="{StaticResource SidebarListBoxItem}" SelectionChanged="NavList_SelectionChanged">
                                <ListBoxItem Content="&#x5B9E;&#x65F6;&#x68C0;&#x6D4B;" Tag="live" />
                                <ListBoxItem Content="&#x4EFB;&#x52A1;&#x914D;&#x7F6E;" Tag="tasks" />
                                <ListBoxItem Content="&#x9879;&#x76EE;&#x4E0E;&#x5DE5;&#x4F4D;" Tag="stations" />
                            </ListBox>
                        </Expander>
                        <Expander Header="&#x6570;&#x636E;&#x4E0E;&#x6A21;&#x578B;" IsExpanded="False">
                            <ListBox ItemContainerStyle="{StaticResource SidebarListBoxItem}" SelectionChanged="NavList_SelectionChanged">
                                <ListBoxItem Content="&#x56FE;&#x7247;&#x6807;&#x6CE8;&#x4E0E;&#x6570;&#x636E;&#x96C6;" Tag="datasets" IsSelected="True" />
                                <ListBoxItem Content="YOLO11 &#x8BAD;&#x7EC3;&#x5E73;&#x53F0;" Tag="training" />
                                <ListBoxItem Content="&#x884C;&#x4E3A;&#x6570;&#x636E;&#x91C7;&#x96C6;" Tag="behavior-collection" />
                                <ListBoxItem Content="&#x884C;&#x4E3A;&#x6807;&#x6CE8;&#x5E73;&#x53F0;" Tag="behavior-annotation" />
                                <ListBoxItem Content="&#x884C;&#x4E3A;&#x8BAD;&#x7EC3;&#x5E73;&#x53F0;" Tag="behavior-training" />
                            </ListBox>
                        </Expander>
                        <Expander Header="&#x7ED3;&#x679C;&#x67E5;&#x770B;" IsExpanded="False">
                            <ListBox ItemContainerStyle="{StaticResource SidebarListBoxItem}" SelectionChanged="NavList_SelectionChanged">
                                <ListBoxItem Content="&#x5386;&#x53F2;&#x8BB0;&#x5F55;" Tag="history" />
                                <ListBoxItem Content="SPC &#x7ED3;&#x679C;&#x56FE;" Tag="spc" />
                                <ListBoxItem Content="&#x65E5;&#x5FD7;&#x7BA1;&#x7406;" Tag="logs" />
                            </ListBox>
                        </Expander>
                        <Expander Header="&#x7CFB;&#x7EDF;&#x7BA1;&#x7406;" IsExpanded="False">
                            <ListBox ItemContainerStyle="{StaticResource SidebarListBoxItem}" SelectionChanged="NavList_SelectionChanged">
                                <ListBoxItem Content="&#x7B97;&#x6CD5;&#x7BA1;&#x7406;" Tag="plugins" />
                                <ListBoxItem Content="&#x8BBE;&#x5907;&#x7BA1;&#x7406;" Tag="devices" />
                                <ListBoxItem Content="&#x7CFB;&#x7EDF;&#x8BBE;&#x7F6E;" Tag="settings" />
                            </ListBox>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
        <ContentControl x:Name="PageHost" Grid.Column="1" />
    </Grid>
</Window>
