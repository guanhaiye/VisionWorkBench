<Window x:Class="VisionWorkbench.App.Shell"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:media="clr-namespace:System.Windows.Media;assembly=PresentationCore"
        Title="VisionWorkbench &#x2014; AI &#x89C6;&#x89C9;&#x5DE5;&#x4F5C;&#x53F0;" Width="1360" Height="860"
        MinWidth="1100" MinHeight="700" WindowStartupLocation="CenterScreen"
        WindowStyle="None" Background="{DynamicResource WindowBrush}" Topmost="False">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Icon>
        <BitmapImage UriSource="/Assets/Branding/logo.png" />
    </Window.Icon>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 允许 Shell 在没有 Application 实例的设计器/UI 测试中独立加载。 -->
                <ResourceDictionary Source="Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <Style TargetType="Expander">
            <EventSetter Event="Expanded" Handler="SidebarExpander_Expanded" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="10,4,10,0" />
            <Setter Property="Padding" Value="4,5" />
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style x:Key="UserHeaderButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="UserChrome" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="UserChrome" Property="Background" Value="{DynamicResource SidebarHoverBrush}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="UserChrome" Property="Background" Value="{DynamicResource SidebarPressedBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="UserSecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#172033"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D9E1EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="MinWidth" Value="76"/>
        </Style>
        <Style x:Key="SidebarListBoxItem" TargetType="ListBoxItem">
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="NavItem_PreviewMouseLeftButtonDown" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SidebarHoverBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SidebarSelectedBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource SidebarSelectedTextBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource SidebarSelectedTextBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.48" />
                    <Setter Property="Foreground" Value="{DynamicResource SidebarMutedTextBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource SidebarMutedTextBrush}" />
                </Trigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="False" />
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource SidebarSelectedBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource SidebarSelectedTextBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource SidebarSelectedTextBrush}" />
                    <Setter Property="Opacity" Value="1" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TitleChrome" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TitleChrome" Property="Background" Value="{DynamicResource AccentSoftBrush}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="TitleChrome" Property="Opacity" Value="0.72"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PasswordRevealButton" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="EyeChrome" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="EyeChrome" Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="EyeChrome" Property="Opacity" Value="0.72"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Image Source="/Assets/Branding/logo.png" Width="25" Height="25" Stretch="Uniform"
                               RenderTransformOrigin="0.5,0.5" Loaded="BrandLogoImage_Loaded" />
                        <TextBlock Text="VisionWorkbench" FontWeight="SemiBold" FontSize="13" Margin="10,0,0,0" Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="  ·  AI 视觉工作台" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"/>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Panel.ZIndex="100"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            IsHitTestVisible="True">
                    <Button x:Name="HelpButton" Style="{StaticResource TitleBarButton}"
                            Width="46" Content="？" FontSize="18" FontWeight="SemiBold"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            IsHitTestVisible="True" Focusable="True"
                            ToolTip="&#x6253;&#x5F00;&#x5E2;&#x52A9;&#x83DC;&#x5355;"
                            PreviewMouseLeftButtonDown="HelpButton_PreviewMouseLeftButtonDown"
                            />
                    <Button x:Name="TopmostButton" Style="{StaticResource TitleBarButton}"
                            Width="46"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            IsHitTestVisible="True" Focusable="True"
                            ToolTip="切换窗口置顶"
                            PreviewMouseLeftButtonDown="TopmostButton_PreviewMouseLeftButtonDown"
                            >
                        <Grid Width="22" Height="22">
                            <Path x:Name="TopmostInactiveIcon" Width="16" Height="16"
                                  Data="M 5,1 L 9,1 L 9,4 L 11,6 L 9,7 L 9,9 L 7,10 L 5,9 L 5,7 L 3,6 L 5,4 Z M 7,10 L 7,13"
                                  Fill="Transparent" Stroke="{DynamicResource SidebarIconStrokeBrush}" StrokeThickness="1.5"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path.RenderTransform>
                                    <media:RotateTransform Angle="35" CenterX="7" CenterY="7" />
                                </Path.RenderTransform>
                            </Path>
                            <Border x:Name="TopmostActiveIconBackground" Width="22" Height="22"
                                    CornerRadius="3" Background="#4F8DE8" Visibility="Collapsed">
                                <Path x:Name="TopmostActiveIcon" Width="16" Height="16"
                                      Data="M 5,1 L 9,1 L 9,4 L 11,6 L 9,7 L 9,9 L 7,10 L 5,9 L 5,7 L 3,6 L 5,4 Z M 7,10 L 7,13"
                                      Fill="White" Stroke="White" StrokeThickness="1.2"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            </Grid>
                    </Button>
                    <Button x:Name="RestartButton" Style="{StaticResource TitleBarButton}"
                            Width="46" Content="↻" FontSize="20" FontWeight="SemiBold"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            IsHitTestVisible="True" Focusable="True"
                            ToolTip="重启软件" Click="Restart_Click" />
                    <Button x:Name="MinimizeButton" Style="{StaticResource TitleBarButton}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            IsHitTestVisible="True" Focusable="True"
                            ToolTip="最小化" Click="MinimizeWindow_Click"
                            PreviewMouseLeftButtonDown="MinimizeWindow_PreviewMouseLeftButtonDown">
                        <Path Data="M 1,8 L 11,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"/>
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButton}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            IsHitTestVisible="True" Focusable="True"
                            ToolTip="最大化" PreviewMouseLeftButtonDown="MaximizeWindow_PreviewMouseLeftButtonDown">
                        <Path x:Name="MaximizeIcon" Data="M 1,1 L 11,1 11,11 1,11 Z" Fill="Transparent"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"/>
                    </Button>
                    <Button x:Name="CloseButton" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            IsHitTestVisible="True" Focusable="True"
                            ToolTip="关闭" PreviewMouseLeftButtonDown="CloseWindow_PreviewMouseLeftButtonDown">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E81123"/><Setter Property="Foreground" Value="White"/></Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path Data="M 2,2 L 10,10 M 10,2 L 2,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource SidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" BorderBrush="{DynamicResource SidebarBorderBrush}" BorderThickness="0,0,0,1" Padding="10,11">
                    <Button x:Name="UserMenuButton" Style="{StaticResource UserHeaderButton}" Click="UserMenu_Click" ToolTip="用户管理">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
                            <Border x:Name="UserAvatarBorder" Width="44" Height="44" CornerRadius="22" Background="#2563EB" VerticalAlignment="Center">
                                <TextBlock x:Name="UserAvatarText" Text="用" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="11,0,0,0">
                                <TextBlock x:Name="CurrentUserText" Text="用户管理" Foreground="{DynamicResource SidebarTextBrush}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="CurrentRoleText" Text="点击登录或设置个人信息" Foreground="{DynamicResource SidebarMutedTextBrush}" FontSize="10" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="⌄" Foreground="{DynamicResource SidebarMutedTextBrush}" FontSize="16" HorizontalAlignment="Center"/>
                        </Grid>
                    </Button>
                </Border>
                <ScrollViewer x:Name="SidebarScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"
                              VerticalContentAlignment="Top" Focusable="True">
                    <StackPanel>
                        <Expander Header="&#x5DE5;&#x4F5C;&#x53F0;" IsExpanded="False">
                            <ListBox x:Name="WorkspaceNavList" ItemContainerStyle="{StaticResource SidebarListBoxItem}" SelectionChanged="NavList_SelectionChanged">
                                <ListBoxItem Content="&#x5B9E;&#x65F6;&#x68C0;&#x6D4B;" Tag="live" />
                                <ListBoxItem Content="&#x4EFB;&#x52A1;&#x914D;&#x7F6E;" Tag="tasks" />
                            </ListBox>
                        </Expander>
                        <Expander Header="&#x6570;&#x636E;&#x4E0E;&#x6A21;&#x578B;" IsExpanded="False">
                            <ListBox x:Name="DataModelNavList" ItemContainerStyle="{StaticResource SidebarListBoxItem}" SelectionChanged="NavList_SelectionChanged">
                                <ListBoxItem Content="AI&#x76EE;&#x6807;&#x68C0;&#x6D4B;" Tag="data-model-detection" />
                                <!-- 兼容旧导航键；新界面分别展示语义分割和实例分割。 -->
                                <ListBoxItem Tag="data-model-segmentation" Visibility="Collapsed" />
                                <ListBoxItem Content="AI&#x8BED;&#x4E49;&#x5206;&#x5272;" Tag="data-model-semantic-segmentation" />
                                <ListBoxItem Content="AI&#x5B9E;&#x4F8B;&#x5206;&#x5272;" Tag="data-model-instance-segmentation" />
                                <ListBoxItem Content="AI&#x884C;&#x4E3A;&#x8BC6;&#x522B;" Tag="data-model-behavior" />
                                <ListBoxItem Content="AI&#x5B57;&#x7B26;&#x8BC6;&#x522B;" Tag="data-model-ai-text" />
                                <ListBoxItem Content="AI&#x6761;&#x7801;&#x8BC6;&#x522B;" Tag="data-model-barcode" />
                                <ListBoxItem Content="AI&#x4E8C;&#x7EF4;&#x7801;&#x8BC6;&#x522B;" Tag="data-model-qrcode" />
                                <ListBoxItem Content="AI&#x5173;&#x952E;&#x70B9;&#x68C0;&#x6D4B;" Tag="data-model-pose" />
                                <ListBoxItem Content="SOP流程制作与配置" Tag="sop" />
                            </ListBox>
                        </Expander>
                        <Expander Header="&#x7ED3;&#x679C;&#x67E5;&#x770B;" IsExpanded="False">
                            <ListBox x:Name="ResultsNavList" ItemContainerStyle="{StaticResource SidebarListBoxItem}" SelectionChanged="NavList_SelectionChanged">
                                <ListBoxItem Content="&#x5386;&#x53F2;&#x8BB0;&#x5F55;" Tag="history" />
                                <ListBoxItem Content="&#x65E5;&#x5FD7;&#x7BA1;&#x7406;" Tag="logs" />
                            </ListBox>
                        </Expander>
                        <Expander Header="&#x901A;&#x8BAF;&#x7BA1;&#x7406;" IsExpanded="False">
                            <ListBox x:Name="CommunicationNavList" ItemContainerStyle="{StaticResource SidebarListBoxItem}" SelectionChanged="NavList_SelectionChanged">
                                <ListBoxItem Content="TCP/IP &#x901A;&#x8BAF;" Tag="communication" />
                            </ListBox>
                        </Expander>
                        <Expander x:Name="SystemManagementExpander" Header="&#x7CFB;&#x7EDF;&#x7BA1;&#x7406;" IsExpanded="False">
                            <ListBox x:Name="SystemNavList" ItemContainerStyle="{StaticResource SidebarListBoxItem}" SelectionChanged="NavList_SelectionChanged">
                                <ListBoxItem Content="&#x7B97;&#x6CD5;&#x7BA1;&#x7406;" Tag="plugins" />
                                <ListBoxItem Content="&#x8BBE;&#x5907;&#x7BA1;&#x7406;" Tag="devices" />
                                <ListBoxItem Content="&#x672C;&#x673A;&#x76D1;&#x63A7;" Tag="monitor" />
                                <ListBoxItem Content="&#x8BB8;&#x53EF;&#x8BC1;&#x7BA1;&#x7406;" Tag="license" />
                                <ListBoxItem Content="&#x7CFB;&#x7EDF;&#x8BBE;&#x7F6E;" Tag="settings" />
                            </ListBox>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="2" BorderBrush="{DynamicResource SidebarBorderBrush}" BorderThickness="0,1,0,0" Padding="18,11">
                    <StackPanel x:Name="SidebarStatusStackPanel" Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#22C55E" Margin="0,0,8,0"/>
                        <TextBlock Text="系统就绪" Foreground="{DynamicResource SidebarStatusTextBrush}" FontSize="11"/>
                        <TextBlock Text="  ·  单实例运行" Foreground="{DynamicResource SidebarStatusMutedBrush}" FontSize="11"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <Border Grid.Row="1" Grid.Column="1" Margin="14" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.10" Color="#334155"/></Border.Effect>
            <ContentControl x:Name="PageHost"
                            Margin="1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"/>
        </Border>
        <Border x:Name="GlobalLogPanel" Grid.Row="1" Grid.Column="1"
                Width="420" MaxHeight="184" Margin="0,0,28,28"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Panel.ZIndex="100" Padding="12,9"
                Background="#E51B222D" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="8">
            <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.24" Color="#000000"/></Border.Effect>
            <DockPanel LastChildFill="True">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock Text="运行日志" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                    <Button Content="清空" Click="ClearGlobalLog_Click"
                            HorizontalAlignment="Right" Padding="6,1" MinWidth="0"
                            FontSize="10" Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource MutedTextBrush}" />
                </Grid>
                <ListBox x:Name="GlobalLogList" Background="Transparent" BorderThickness="0"
                         MaxHeight="140" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Timestamp}" Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="10" VerticalAlignment="Top" />
                                <TextBlock Grid.Column="1" Text="{Binding Message}" Foreground="{DynamicResource TextBrush}"
                                           FontSize="11" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <Popup x:Name="UserMenuPopup" PlacementTarget="{Binding ElementName=UserMenuButton}" Placement="Right"
               HorizontalOffset="8" VerticalOffset="0" StaysOpen="False" AllowsTransparency="True">
            <Border x:Name="UserPopupContentBorder" Width="330" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.22" Color="#334155"/></Border.Effect>
                <StackPanel TextElement.Foreground="{DynamicResource TextBrush}">
                <Grid Margin="0,0,0,12" MinHeight="62">
                    <StackPanel HorizontalAlignment="Left" Margin="0,0,70,0">
                        <TextBlock Text="&#x7528;&#x6237;&#x4FE1;&#x606F;" FontSize="18" FontWeight="Bold" />
                        <TextBlock Text="&#x5F53;&#x524D;&#x767B;&#x5F55;&#x7528;&#x6237;&#x4FE1;&#x606F;&#xFF08;&#x53EA;&#x8BFB;&#xFF09;" Foreground="#64748B"
                                   FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border x:Name="AvatarPreviewBorder" Width="54" Height="54" CornerRadius="27"
                            Background="#2563EB" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Cursor="Hand" MouseLeftButtonDown="AvatarPreview_MouseLeftButtonDown">
                        <TextBlock x:Name="AvatarPreviewText" Foreground="White" FontSize="20"
                                   FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
                <StackPanel>
                    <TextBlock Text="用户管理" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="登录信息仅保存在当前电脑" Foreground="#64748B" FontSize="11" Margin="0,3,0,14"/>
                    <TextBlock Text="姓名"/>
                    <TextBox x:Name="UserNameText" Margin="0,5,0,3" TextChanged="RegistrationUserName_TextChanged"/>
                    <TextBlock x:Name="RegistrationUserNameError" Foreground="{DynamicResource DangerBrush}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed" />
                    <TextBlock Text="角色"/>
                    <ComboBox x:Name="UserRoleCombo" Margin="0,5,0,12">
                        <ComboBoxItem Content="超级管理员" Tag="admin" IsEnabled="False" />
                        <ComboBoxItem Content="操作员" Tag="operator"/>
                        <ComboBoxItem Content="工程师" Tag="engineer"/>
                        <ComboBoxItem Content="专家" Tag="expert"/>
                    </ComboBox>
                    <StackPanel x:Name="AvatarRegistrationHint" Orientation="Horizontal" Margin="0,0,0,12">
                        <Border x:Name="AvatarRegistrationPreviewBorder" Width="54" Height="54" CornerRadius="27"
                                Visibility="Collapsed"
                                Background="#2563EB" VerticalAlignment="Center">
                            <TextBlock x:Name="AvatarRegistrationPreviewText" Foreground="White" FontSize="20"
                                       FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="头像" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="操作员可执行任务；工程师可编辑任务；专家可修改高级参数。" Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <StackPanel x:Name="RegistrationPasswordPanel" Margin="0,0,0,12">
                        <TextBlock Text="密码" />
                        <PasswordBox x:Name="RegistrationPasswordBox" Margin="0,5,0,3" MinHeight="32"
                                     PasswordChanged="RegistrationPasswordBox_PasswordChanged" />
                        <TextBlock x:Name="RegistrationPasswordError" Foreground="{DynamicResource DangerBrush}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed" />
                        <TextBlock Text="确认密码" />
                        <PasswordBox x:Name="RegistrationConfirmPasswordBox" Margin="0,5,0,3" MinHeight="32"
                                     PasswordChanged="RegistrationConfirmPasswordBox_PasswordChanged" />
                        <TextBlock x:Name="RegistrationConfirmPasswordError" Foreground="{DynamicResource DangerBrush}" FontSize="11"
                                   TextWrapping="Wrap" Visibility="Collapsed" />
                    </StackPanel>
                    <StackPanel x:Name="UserActionsPanel" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="退出登录" Click="Logout_Click" Style="{StaticResource UserSecondaryButton}"/>
                        <Button Content="登录 / 保存" Click="SaveUser_Click"/>
                        <Button x:Name="SuperAdminButton" Content="用户管理" Click="SuperAdminButton_Click"
                                Style="{StaticResource SecondaryButton}" Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>
                <StackPanel x:Name="LoginPanel" Visibility="Collapsed">
                    <TextBlock Text="用户名" />
                    <TextBox x:Name="LoginNameText" Margin="0,5,0,10" />
                    <TextBlock Text="密码" />
                    <Grid Margin="0,5,0,8" MinHeight="32">
                        <PasswordBox x:Name="LoginPasswordBox" Padding="9,6,40,6" />
                        <TextBox x:Name="LoginPasswordTextBox" Padding="9,6,40,6" Visibility="Collapsed" />
                        <Button x:Name="ToggleLoginPasswordButton" Style="{StaticResource PasswordRevealButton}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                ToolTip="显示密码" Click="ToggleLoginPassword_Click">
                            <Grid Width="20" Height="18">
                                <Path x:Name="ShowPasswordIcon" Data="M 1,9 C 4,3 16,3 19,9 C 16,15 4,15 1,9 Z"
                                      Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.7" />
                                <Ellipse Width="4.5" Height="4.5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Grid x:Name="HidePasswordIcon" Visibility="Collapsed">
                                    <Path Data="M 1,9 C 4,3 16,3 19,9 C 16,15 4,15 1,9 Z"
                                          Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.7" />
                                    <Ellipse Width="4.5" Height="4.5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Path Data="M 2,2 L 18,16"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Grid>
                            </Grid>
                        </Button>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <CheckBox x:Name="RememberPasswordCheckBox" Content="记住密码" Margin="2,4,18,4"
                                  Checked="RememberPasswordOption_Changed"
                                  Unchecked="RememberPasswordOption_Changed" />
                        <CheckBox x:Name="AutoLoginCheckBox" Content="自动登录" Margin="2,4,2,4"
                                  Checked="AutoLoginOption_Changed"
                                  Unchecked="AutoLoginOption_Changed" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="注册" Click="Register_Click" Style="{StaticResource SecondaryButton}" />
                        <Button Content="登录" Click="Login_Click" />
                    </StackPanel>
                </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
        <Popup x:Name="HelpMenuPopup" PlacementTarget="{Binding ElementName=HelpButton}" Placement="Bottom"
               HorizontalOffset="-82" VerticalOffset="4" StaysOpen="True" AllowsTransparency="True">
            <Border Width="250" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="8">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.22" Color="#000000" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="&#x5E2E;&#x52A9;&#x4E2D;&#x5FC3;" Margin="10,5,10,7"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" />
                    <Button Content="Python&#x811A;&#x672C;&#x7F16;&#x5199;&#x89C4;&#x5219;"
                            HorizontalContentAlignment="Left" Padding="12,9"
                            Click="PythonScriptRules_Click" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
