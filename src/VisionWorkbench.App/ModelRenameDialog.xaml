<Window x:Class="VisionWorkbench.App.ModelRenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="重命名模型节点"
        Width="390"
        Height="170"
        Style="{StaticResource ThemedDialogWindow}"
        WindowStartupLocation="CenterOwner">
    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBox x:Name="NameText" Grid.Row="0" Margin="0,0,0,12" />
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="确定" Click="Confirm_Click" Width="76" Margin="0,0,8,0" />
                <Button Content="取消" Click="Cancel_Click" Width="76" Style="{StaticResource SecondaryButton}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
