<UserControl x:Class="VisionWorkbench.App.DatasetAnnotationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:VisionWorkbench.App"
             PreviewKeyDown="DatasetAnnotationPage_PreviewKeyDown">
    <UserControl.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource PageTextBlockBaseStyle}" />
    </UserControl.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
            <WrapPanel.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource AnnotationToolbarButton}" />
            </WrapPanel.Resources>
            <TextBlock x:Name="PlatformTitleText" Text="目标检测标注平台" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,14,0" />
            <Button Content="新建数据集" Click="NewDataset_Click" />
            <Button Content="加载数据集" Click="LoadDataset_Click" Margin="6,0,0,0" />
            <Button Content="选择图片目录" Click="BrowseRoot_Click" Margin="6,0,0,0" />
            <Button Content="保存数据集" Click="SaveDataset_Click" Margin="6,0,0,0" />
            <Button Content="自动划分数据集" Click="AutoSplit_Click" Margin="6,0,0,0" />
            <Button x:Name="ExportDatasetButton" Content="导出数据集" Click="ExportDataset_Click" Margin="6,0,0,0" />
        </WrapPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock DockPanel.Dock="Top" Text="数据集" FontWeight="Bold" Margin="0,0,0,4" />
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        Background="{DynamicResource InputBrush}" CornerRadius="6" Padding="2">
                    <ListBox x:Name="DatasetList"
                             DisplayMemberPath="Name"
                             SelectionChanged="DatasetList_SelectionChanged"
                             PreviewMouseRightButtonDown="DatasetList_PreviewMouseRightButtonDown"
                             BorderThickness="0"
                             Background="Transparent" />
                </Border>
            </DockPanel>

            <DockPanel Grid.Column="1" Margin="0,0,8,0">
                <TextBlock DockPanel.Dock="Top" Text="图片列表" FontWeight="Bold" Margin="0,0,0,4" />
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        Background="{DynamicResource InputBrush}" CornerRadius="6" Padding="2">
                    <Grid>
                <ListBox x:Name="ImageList"
                         SelectionChanged="ImageList_SelectionChanged"
                         PreviewMouseRightButtonDown="ImageList_PreviewMouseRightButtonDown"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding FileName}" />
                                <TextBlock Grid.Column="1" FontWeight="Bold" Margin="8,0,2,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="未" />
                                            <Setter Property="Foreground" Value="#B45309" />
                                            <Setter Property="ToolTip" Value="未标注" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasAnnotation}" Value="True">
                                                    <Setter Property="Text" Value="标" />
                                                    <Setter Property="Foreground" Value="DarkGreen" />
                                                    <Setter Property="ToolTip" Value="已标注" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="2" Text="{Binding SplitDisplay}" Foreground="#1565C0" FontWeight="Bold" Margin="12,0,2,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                        <TextBlock x:Name="ImageListEmptyText" Text="暂无图片，请先选择图片目录"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   IsHitTestVisible="False" />
                    </Grid>
                </Border>
            </DockPanel>

            <Grid x:Name="DatasetInfoPanel" Grid.Column="2" Margin="0,0,8,0">
                <GroupBox Header="数据集信息">
                    <StackPanel Margin="6">
                        <TextBlock Text="名称" />
                        <TextBox x:Name="DatasetNameText" Margin="0,2,0,6" />
                        <TextBlock Text="原始图片目录（仅读取）" />
                        <TextBox x:Name="SourceRootText" IsReadOnly="True" TextWrapping="Wrap" Margin="0,2,0,6" />
                        <TextBlock Text="数据集目录（图片副本）" />
                        <TextBox x:Name="DatasetRootText" IsReadOnly="True" TextWrapping="Wrap" Margin="0,2,0,6" />
                        <TextBlock Text="类别（英文逗号 , 或中文逗号 ， 分隔）" />
                        <TextBox x:Name="DatasetClassesText" AcceptsReturn="True" TextWrapping="Wrap" Height="60" Margin="0,2,0,6" />
                        <TextBlock x:Name="DatasetTaskTypeText" Text="标注类型：未选择" Margin="0,0,0,6" Foreground="#333" TextWrapping="Wrap" />
                        <TextBlock Text="标注保存在数据集目录下的 .visionworkbench/annotations；原始图片目录不会被写入。" Foreground="#666" TextWrapping="Wrap" />
                    </StackPanel>
                </GroupBox>
            </Grid>

            <Grid Grid.Column="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="270" MinWidth="220" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ScrollViewer x:Name="AnnotationToolsPanel" Grid.Row="0" Grid.ColumnSpan="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="92" Margin="0,0,0,6">
                    <WrapPanel>
                    <CheckBox x:Name="PromptClassAfterDrawCheckBox" Content=""
                              ToolTip="绘制后选择类别"
                              IsChecked="False" VerticalAlignment="Center" Margin="0,0,8,0"
                              Visibility="Collapsed" />
                    <TextBlock Text="默认类别：" VerticalAlignment="Center" />
                    <ComboBox x:Name="ClassCombo" Width="150" />
                    <Button x:Name="YoloeButton" Content="智能标注" Click="YoloeCurrent_Click" Margin="8,0,0,0" Visibility="Collapsed" />
                    <TextBlock x:Name="YoloeOutputModeLabel" Text="输出：" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Collapsed" />
                    <ComboBox x:Name="YoloeOutputModeCombo" Width="170" Margin="4,0,0,0" SelectedIndex="2" Visibility="Collapsed">
                        <ComboBoxItem Content="仅输出框" Tag="boxes" />
                        <ComboBoxItem Content="仅输出分割轮廓" Tag="contours" />
                        <ComboBoxItem Content="框和轮廓都输出" Tag="both" />
                    </ComboBox>
                    <Button x:Name="ManualDrawButton" Content="外轮廓绘制" Click="ManualDraw_Click" Margin="8,0,0,0" Visibility="Collapsed" />
                    <Button x:Name="BrushButton" Content="画刷" Click="Brush_Click" Margin="8,0,0,0" Visibility="Collapsed" />
                    <Button x:Name="EraserButton" Content="橡皮擦" Click="Eraser_Click" Margin="8,0,0,0" Visibility="Collapsed" />
                    <Button x:Name="Sam1Button" Content="智能标注" Click="Sam1ClickMode_Click" Margin="8,0,0,0" Visibility="Collapsed" />
                    <TextBlock x:Name="ZoomText" Text="缩放：100%" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock x:Name="FinishShortcutHint" Text="S：结束本次标注" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource MutedTextBrush}" Visibility="Collapsed" />
                    </WrapPanel>
                </ScrollViewer>
                <local:ImageViewer x:Name="AnnotationScrollViewer" Grid.Row="1" Grid.RowSpan="3" Grid.Column="0"
                             Background="#202020"
                             SizeChanged="AnnotationScrollViewer_SizeChanged">
                    <Border x:Name="AnnotationSurface" Background="#202020" BorderBrush="#888" BorderThickness="1">
                    <Grid>
                        <Image x:Name="AnnotationImage" Stretch="Uniform" />
                        <Canvas x:Name="AnnotationCanvas" Background="#01000000"
                                PreviewMouseWheel="AnnotationCanvas_PreviewMouseWheel"
                                MouseLeftButtonDown="AnnotationCanvas_MouseLeftButtonDown"
                                MouseRightButtonDown="AnnotationCanvas_MouseRightButtonDown"
                                MouseEnter="AnnotationCanvas_MouseEnter"
                                MouseMove="AnnotationCanvas_MouseMove"
                                MouseLeave="AnnotationCanvas_MouseLeave"
                                MouseLeftButtonUp="AnnotationCanvas_MouseLeftButtonUp"
                                SizeChanged="AnnotationCanvas_SizeChanged" />
                    </Grid>
                    </Border>
                </local:ImageViewer>
                <Expander x:Name="PanelOptionsExpander" Grid.Row="1" Grid.RowSpan="3" Grid.Column="0"
                          HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0"
                          ExpandDirection="Right" IsExpanded="False"
                          Panel.ZIndex="20">
                    <Expander.Style>
                        <Style TargetType="Expander">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Expander">
                                        <Border Background="{DynamicResource SurfaceBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="0,6,6,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter x:Name="ExpandSite" Grid.Column="0"
                                                                  Content="{TemplateBinding Content}"
                                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                  Visibility="Collapsed" />
                                                <ToggleButton x:Name="HeaderSite" Grid.Column="1"
                                                              Content="{TemplateBinding Header}"
                                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                              Background="Transparent" BorderThickness="0" Padding="0"
                                                              Focusable="False">
                                                    <ToggleButton.Template>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <ContentPresenter Content="{TemplateBinding Content}"
                                                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                              HorizontalAlignment="Stretch"
                                                                              VerticalAlignment="Stretch" />
                                                        </ControlTemplate>
                                                    </ToggleButton.Template>
                                                </ToggleButton>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsExpanded" Value="True">
                                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Expander.Style>
                    <Expander.Header>
                        <Border Background="Transparent" BorderThickness="0" Padding="5,10">
                            <TextBlock Text="显示设置" FontWeight="SemiBold" TextWrapping="Wrap"
                                       TextAlignment="Center" Width="20" />
                        </Border>
                    </Expander.Header>
                    <Border Background="Transparent" BorderThickness="0" Padding="10">
                        <StackPanel>
                            <TextBlock Text="显示面板" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <CheckBox x:Name="AnnotationInfoCheckBox" Content="标注信息" IsChecked="True"
                                      Checked="PanelOption_Changed" Unchecked="PanelOption_Changed" />
                            <Separator x:Name="InstanceSegmentationOptionsSeparator" Margin="0,8,0,6" Visibility="Collapsed" />
                            <CheckBox x:Name="BoundingBoxCheckBox" Content="目标框" IsChecked="True"
                                      Visibility="Collapsed" Checked="PanelOption_Changed" Unchecked="PanelOption_Changed"
                                      Margin="0,0,0,6" />
                            <CheckBox x:Name="ContourCheckBox" Content="轮廓" IsChecked="True"
                                      Visibility="Collapsed" Checked="PanelOption_Changed" Unchecked="PanelOption_Changed" />
                        </StackPanel>
                    </Border>
                </Expander>
                <Grid Grid.Row="1" Grid.Column="1" Margin="6,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="当前图片标注" FontWeight="Bold" Margin="0,0,0,6" />
                    <Grid Grid.Row="1" Margin="0,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="AnnotationInfoHeaderRow" Height="Auto" />
                        <RowDefinition x:Name="AnnotationInfoListRow" Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{DynamicResource InputBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,1,1,0"
                            Padding="8,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="类别" FontWeight="Bold" />
                            <TextBlock Grid.Column="1" Text="形状" FontWeight="Bold" />
                            <TextBlock Grid.Column="2" Text="位置 / 尺寸" FontWeight="Bold" />
                        </Grid>
                    </Border>
                    <ListBox Grid.Row="1" x:Name="AnnotationList"
                             SelectionChanged="AnnotationList_SelectionChanged"
                             PreviewMouseLeftButtonDown="AnnotationList_PreviewMouseLeftButtonDown"
                             PreviewMouseRightButtonDown="AnnotationList_PreviewMouseRightButtonDown"
                             HorizontalContentAlignment="Stretch"
                             VerticalContentAlignment="Top"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding ClassName}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Shape}" />
                                    <TextBlock Grid.Column="2">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0:0.000}, {1:0.000}, {2:0.000}, {3:0.000}">
                                                <Binding Path="X" />
                                                <Binding Path="Y" />
                                                <Binding Path="Width" />
                                                <Binding Path="Height" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
        <Border Grid.Row="2" BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="4" Margin="0,8,0,0">
            <TextBlock x:Name="StatusText" Foreground="Green" TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
