<UserControl x:Class="VisionWorkbench.App.DatasetAnnotationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
            <Button Content="新建数据集" Click="NewDataset_Click" />
            <Button Content="选择图片目录" Click="BrowseRoot_Click" Margin="6,0,0,0" />
            <Button Content="保存数据集" Click="SaveDataset_Click" Margin="6,0,0,0" />
            <Button Content="导出 YOLO 数据集" Click="ExportDataset_Click" Margin="6,0,0,0" />
        </WrapPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock DockPanel.Dock="Top" Text="数据集" FontWeight="Bold" Margin="0,0,0,4" />
                <ListBox x:Name="DatasetList" DisplayMemberPath="Name" SelectionChanged="DatasetList_SelectionChanged" />
            </DockPanel>

            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                <GroupBox Header="数据集信息">
                    <StackPanel Margin="6">
                        <TextBlock Text="名称" />
                        <TextBox x:Name="DatasetNameText" Margin="0,2,0,6" />
                        <TextBlock Text="图片目录" />
                        <TextBox x:Name="DatasetRootText" IsReadOnly="True" TextWrapping="Wrap" Margin="0,2,0,6" />
                        <TextBlock Text="类别（逗号分隔）" />
                        <TextBox x:Name="DatasetClassesText" AcceptsReturn="True" TextWrapping="Wrap" Height="60" Margin="0,2,0,6" />
                        <TextBlock x:Name="DatasetTaskTypeText" Text="标注类型：未选择" Margin="0,0,0,6" Foreground="#333" TextWrapping="Wrap" />
                        <TextBlock Text="标注保存在图片目录下的 .visionworkbench/annotations" Foreground="#666" TextWrapping="Wrap" />
                    </StackPanel>
                </GroupBox>
                <TextBlock Text="图片列表" FontWeight="Bold" Margin="0,10,0,4" />
                <ListBox x:Name="ImageList"
                         SelectionChanged="ImageList_SelectionChanged"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding FileName}" />
                                <TextBlock Grid.Column="1" Text="标" Foreground="DarkGreen" FontWeight="Bold" Margin="8,0,2,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasAnnotation}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="150" />
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="92" Margin="0,0,0,6">
                    <WrapPanel>
                    <TextBlock x:Name="AnnotationShapeText" Text="形状：未选择" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="标注类别：" VerticalAlignment="Center" />
                    <ComboBox x:Name="ClassCombo" Width="150" />
                    <Button x:Name="YoloeButton" Content="YOLOE 自动标注当前图" Click="YoloeCurrent_Click" Margin="8,0,0,0" Visibility="Collapsed" />
                    <Button x:Name="Sam3Button" Content="SAM3 点击分割" Click="Sam3ClickMode_Click" Margin="8,0,0,0" Visibility="Collapsed" />
                    </WrapPanel>
                </ScrollViewer>
                <Border Grid.Row="1" Background="#202020" BorderBrush="#888" BorderThickness="1">
                    <Grid>
                        <Image x:Name="AnnotationImage" Stretch="Fill" />
                        <Canvas x:Name="AnnotationCanvas" Background="#01000000"
                                MouseLeftButtonDown="AnnotationCanvas_MouseLeftButtonDown"
                                MouseRightButtonDown="AnnotationCanvas_MouseRightButtonDown"
                                MouseMove="AnnotationCanvas_MouseMove"
                                MouseLeftButtonUp="AnnotationCanvas_MouseLeftButtonUp"
                                SizeChanged="AnnotationCanvas_SizeChanged" />
                    </Grid>
                </Border>
                <ListBox Grid.Row="2" x:Name="AnnotationList"
                         SelectionChanged="AnnotationList_SelectionChanged"
                         PreviewMouseLeftButtonDown="AnnotationList_PreviewMouseLeftButtonDown"
                         PreviewMouseRightButtonDown="AnnotationList_PreviewMouseRightButtonDown"
                         Margin="0,6,0,0" />
            </Grid>
        </Grid>
        <TextBlock Grid.Row="2" x:Name="StatusText" Foreground="Green" Margin="0,8,0,0" TextWrapping="Wrap" />
    </Grid>
</UserControl>
