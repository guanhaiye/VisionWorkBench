<UserControl x:Class="VisionWorkbench.App.SystemMonitorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource PageTextBlockBaseStyle}" />
    </UserControl.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,5">
            <Button Content="刷新" Click="Refresh_Click" DockPanel.Dock="Right" />
            <TextBlock Text="本机监控" FontSize="22" FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}" />
        </DockPanel>
        <TextBlock Grid.Row="1" Text="实时查看本机处理器、内存、显卡显存和系统磁盘状态。"
                   Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,18" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <UniformGrid Columns="2" Rows="2">
                <Border Margin="0,0,10,10" Padding="18" Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="CPU" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock x:Name="CpuValueText" Text="--" FontSize="30" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" Margin="0,10,0,8" />
                        <ProgressBar x:Name="CpuProgress" Minimum="0" Maximum="100" Height="10"
                                     Foreground="{DynamicResource AccentBrush}" Background="#3A4350" />
                        <TextBlock x:Name="CpuDetailText" Text="等待采样..." Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Border Margin="10,0,0,10" Padding="18" Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="内存" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock x:Name="MemoryValueText" Text="--" FontSize="30" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" Margin="0,10,0,8" />
                        <ProgressBar x:Name="MemoryProgress" Minimum="0" Maximum="100" Height="10"
                                     Foreground="{DynamicResource AccentBrush}" Background="#3A4350" />
                        <TextBlock x:Name="MemoryDetailText" Text="等待读取..." Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,10,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Margin="0,10,10,0" Padding="18" Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="显存" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock x:Name="GpuValueText" Text="--" FontSize="30" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" Margin="0,10,0,8" />
                        <ProgressBar x:Name="GpuProgress" Minimum="0" Maximum="100" Height="10"
                                     Foreground="{DynamicResource AccentBrush}" Background="#3A4350" />
                        <TextBlock x:Name="GpuDetailText" Text="等待检测显卡..." Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,10,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Margin="10,10,0,0" Padding="18" Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="磁盘（全部）" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock x:Name="DiskValueText" Text="--" FontSize="30" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" Margin="0,10,0,8" />
                        <ProgressBar x:Name="DiskProgress" Minimum="0" Maximum="100" Height="10"
                                     Foreground="{DynamicResource AccentBrush}" Background="#3A4350" />
                        <TextBlock x:Name="DiskDetailText" Text="等待读取..."
                                   Margin="0,14,0,10" MinHeight="32"
                                   Padding="0,4,0,4"
                                   LineHeight="22" LineStackingStrategy="BlockLineHeight"
                                   VerticalAlignment="Top"
                                   HorizontalAlignment="Stretch"
                                   Foreground="{DynamicResource TextBrush}"
                                   TextWrapping="Wrap" TextTrimming="None" />
                        <ItemsControl x:Name="DiskItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="145" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <ProgressBar Grid.Column="1" Value="{Binding UsagePercent, Mode=OneWay}" Minimum="0" Maximum="100"
                                                     Height="8" Margin="8,0,8,0"
                                                     Foreground="{DynamicResource AccentBrush}" Background="#3A4350" />
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding UsageText}" TextAlignment="Right"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding CapacityText}" TextAlignment="Right"
                                                       TextWrapping="NoWrap" FontSize="10"
                                                       Foreground="{DynamicResource MutedTextBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </ScrollViewer>
    </Grid>
</UserControl>
