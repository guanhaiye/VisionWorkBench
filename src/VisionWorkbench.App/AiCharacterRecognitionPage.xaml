<UserControl x:Class="VisionWorkbench.App.AiCharacterRecognitionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:VisionWorkbench.App">
    <UserControl.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource PageTextBlockBaseStyle}" />
        <Style TargetType="Button" BasedOn="{StaticResource AnnotationToolbarButton}">
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Margin" Value="4,2" />
            <Setter Property="MinHeight" Value="42" />
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <Style x:Key="DisplayOptionsExpanderStyle" TargetType="Expander">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="0,6,6,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="ExpandSite"
                                                  Grid.Column="0"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Visibility="Collapsed" />
                                <ToggleButton x:Name="HeaderSite"
                                              Grid.Column="1"
                                              Content="{TemplateBinding Header}"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Padding="0"
                                              Focusable="False">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <ContentPresenter Content="{TemplateBinding Content}"
                                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                                              HorizontalAlignment="Stretch"
                                                              VerticalAlignment="Stretch" />
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PlatformTitleText"
                       Text="AI字符识别标注平台"
                       FontSize="18"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="0,0,14,0" />
            <WrapPanel x:Name="AnnotationToolbarPanel"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       Visibility="Collapsed">
                <Button Content="新建数据集" Click="NewAnnotationDataset_Click" />
                <Button Content="加载数据集" Click="LoadAnnotationDataset_Click" />
                <Button Content="选择图片目录" Click="ChooseAnnotationFolder_Click" />
                <Button x:Name="SaveAnnotationButton" Content="保存数据集" Click="SaveAnnotation_Click" />
                <Button Content="自动划分数据集" Click="AutoSplitAnnotationDataset_Click" />
                <Button Content="导出数据集" Click="ExportAnnotationDataset_Click" />
            </WrapPanel>
            <Border Grid.Column="1"
                    Background="#CCFBF1"
                    CornerRadius="8"
                    Padding="12,8"
                    HorizontalAlignment="Right"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="当前模型" FontSize="11" Foreground="#0F766E" />
                    <TextBlock Text="PaddleOCR-VL-1.6" FontWeight="Bold" Foreground="#115E59" />
                    <TextBlock x:Name="ModelScopeText" FontSize="11" Foreground="#0F766E" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10"
                Visibility="Collapsed">
            <TextBlock x:Name="RuntimeStatusText" TextWrapping="Wrap" />
        </Border>

        <Grid x:Name="AnnotationPanel" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock DockPanel.Dock="Top" Text="数据集" FontWeight="Bold" Margin="0,0,0,4" />
                <Border BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        Background="{DynamicResource InputBrush}"
                        CornerRadius="6"
                        Padding="2">
                    <ListBox x:Name="AnnotationDatasetList"
                             BorderThickness="0"
                             Background="Transparent" />
                </Border>
            </DockPanel>

            <DockPanel Grid.Column="1" Margin="0,0,8,0">
                <TextBlock DockPanel.Dock="Top" Text="图片列表" FontWeight="Bold" Margin="0,0,0,4" />
                <Border BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        Background="{DynamicResource InputBrush}"
                        CornerRadius="6"
                        Padding="2">
                    <Grid>
                        <ListBox x:Name="AnnotationImageList"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 SelectionChanged="AnnotationImageList_SelectionChanged"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding FileName}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="文"
                                                   Foreground="DarkGreen"
                                                   FontWeight="Bold"
                                                   Margin="10,0,2,0" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="AnnotationImageListEmptyText"
                                   Text="暂无图片，请先选择图片目录"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   IsHitTestVisible="False" />
                    </Grid>
                </Border>
            </DockPanel>

            <Grid Grid.Column="2" Margin="0,0,8,0">
                <GroupBox Header="数据集信息">
                    <StackPanel Margin="6">
                        <TextBlock Text="名称" />
                        <TextBox x:Name="AnnotationDatasetNameText" IsReadOnly="True" Margin="0,2,0,6" />
                        <TextBlock Text="图片目录（仅读取）" />
                        <TextBox x:Name="AnnotationSourceRootText" IsReadOnly="True" TextWrapping="Wrap" Margin="0,2,0,6" />
                        <TextBlock Text="数据集目录（图片副本）" />
                        <TextBox x:Name="AnnotationDatasetRootText" IsReadOnly="True" TextWrapping="Wrap" Margin="0,2,0,6" />
                        <TextBlock Text="类别" />
                        <TextBox x:Name="AnnotationClassesText" IsReadOnly="True" Margin="0,2,0,6" />
                        <TextBlock x:Name="AnnotationKindText" Text="标注类型：未选择" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <TextBlock Text="标注说明" />
                        <TextBlock x:Name="AnnotationDescriptionText"
                                   Text="为当前图片填写识别文本，保存后用于训练。"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,2,0,6" />
                        <TextBlock x:Name="AnnotationRootText"
                                   Text="尚未选择数据集"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>
                </GroupBox>
            </Grid>

            <Grid Grid.Column="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" MaxHeight="92" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,6">
                    <WrapPanel>
                        <TextBlock Text="标注类别：" VerticalAlignment="Center" />
                        <ComboBox Width="150" IsEnabled="False" Margin="8,0,0,0">
                            <ComboBoxItem x:Name="AnnotationKindOption" Content="条码" IsSelected="True" />
                        </ComboBox>
                        <Button Content="智能标注" IsEnabled="False" ToolTip="条码识别将在测试流程中执行" Margin="8,0,0,0" />
                        <TextBlock Text="缩放：100%" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </WrapPanel>
                </ScrollViewer>

                <Grid Grid.Row="1">
                    <local:ImageViewer Background="#202020" BorderThickness="0">
                        <Border Background="#202020" BorderBrush="#888" BorderThickness="1">
                            <Image x:Name="AnnotationPreview" Stretch="Uniform" />
                        </Border>
                    </local:ImageViewer>
                    <Expander HorizontalAlignment="Left"
                              VerticalAlignment="Top"
                              ExpandDirection="Right"
                              Style="{StaticResource DisplayOptionsExpanderStyle}"
                              Panel.ZIndex="20">
                        <Expander.Header>
                            <Border Background="Transparent" BorderThickness="0" Padding="5,10">
                                <TextBlock Text="显示设置"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Width="20" />
                            </Border>
                        </Expander.Header>
                        <Border Background="Transparent" BorderThickness="0" Padding="10">
                            <StackPanel>
                                <TextBlock Text="显示面板" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <CheckBox Content="识别信息" IsChecked="True" />
                                <CheckBox Content="图片预览" IsChecked="True" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </Expander>
                </Grid>

                <TextBlock Grid.Row="2" Text="当前图片识别" FontWeight="Bold" Margin="0,6,0,0" />
                <Border Grid.Row="3"
                        Background="{DynamicResource InputBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        Padding="8,5"
                        Margin="0,4,0,0">
                    <StackPanel>
                        <TextBlock Text="识别文本" FontWeight="Bold" />
                        <TextBox x:Name="AnnotationText"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 MinHeight="74" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="4" Margin="0,8,0,0">
            <TextBlock x:Name="AnnotationStatusText" Foreground="Green" TextWrapping="Wrap" />
        </Border>

        <Grid x:Name="TrainingPanel" Grid.Row="1" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="TrainingTitleText" Text="字符识别训练" FontSize="17" FontWeight="SemiBold" />
                <TextBlock x:Name="TrainingDescriptionText"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Margin="0,5,0,14" />
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="数据集目录" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBox x:Name="TrainingRootText" Grid.Column="1" IsReadOnly="True" />
                    <Button Grid.Column="2" Content="选择" Click="ChooseTrainingFolder_Click" />
                </Grid>
                <WrapPanel Margin="0,0,0,14">
                    <TextBlock Text="训练轮数" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox x:Name="TrainingEpochText" Text="20" Width="70" Margin="0,0,18,0" />
                    <TextBlock Text="批大小" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox x:Name="TrainingBatchText" Text="2" Width="70" Margin="0,0,18,0" />
                    <Button x:Name="PrepareTrainingButton" Content="生成训练配置" Click="PrepareTraining_Click" />
                </WrapPanel>
                <Border Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1" CornerRadius="8" Padding="12">
                    <TextBlock x:Name="TrainingHintText" TextWrapping="Wrap" Foreground="#9A3412" />
                </Border>
                <TextBlock x:Name="TrainingStatusText" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,12,0,0" />
            </StackPanel>
        </Grid>

        <Grid x:Name="TestPanel" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="选择测试图片" Click="ChooseTestImage_Click" />
                <Button x:Name="RunOcrButton" Content="执行字符识别" Click="RunOcr_Click" />
                <TextBlock x:Name="TestImageText" Text="尚未选择图片" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>
                <local:ImageViewer Grid.Column="0" Background="#202020" BorderThickness="0" Margin="0,0,12,0">
                    <Border Background="#202020" BorderBrush="#888" BorderThickness="1">
                        <Image x:Name="TestPreview" Stretch="Uniform" />
                    </Border>
                </local:ImageViewer>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="识别结果" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="TestDescriptionText" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,8" />
                    <TextBox x:Name="TestResultText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="220" />
                    <TextBlock x:Name="TestStatusText" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,10,0,0" />
                </StackPanel>
            </Grid>
        </Grid>

    </Grid>
</UserControl>
