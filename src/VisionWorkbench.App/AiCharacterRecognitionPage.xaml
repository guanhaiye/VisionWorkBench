<UserControl x:Class="VisionWorkbench.App.AiCharacterRecognitionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:VisionWorkbench.App">
    <UserControl.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="8,6" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18">
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="PlatformTitleText" Text="AI字符识别标注平台" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="面向字符检测、识别与复杂版面解析的统一工作台。" Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="#CCFBF1" CornerRadius="8" Padding="12,8" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="当前模型" FontSize="11" Foreground="#0F766E" />
                        <TextBlock Text="PaddleOCR-VL-1.6" FontWeight="Bold" Foreground="#115E59" />
                        <TextBlock x:Name="ModelScopeText" Text="SOTA · 复杂文档/字符识别" FontSize="11" Foreground="#0F766E" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="运行时" FontWeight="SemiBold" Margin="0,0,16,0" />
                    <TextBlock x:Name="RuntimeStatusText" Grid.Column="1" TextWrapping="Wrap" />
                </Grid>
            </Border>

            <Grid x:Name="AnnotationPanel" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="选择数据集目录" Click="ChooseAnnotationFolder_Click" />
                    <Button x:Name="SaveAnnotationButton" Content="保存字符标注" Click="SaveAnnotation_Click" />
                    <TextBlock x:Name="AnnotationRootText" Text="尚未选择数据集" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>
                <Grid Grid.Row="1" MinHeight="360">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,12,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="图片列表" FontWeight="Bold" Margin="0,0,0,6" />
                            <ListBox x:Name="AnnotationImageList" BorderThickness="0" SelectionChanged="AnnotationImageList_SelectionChanged" />
                        </DockPanel>
                    </Border>
                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="250" /></Grid.ColumnDefinitions>
                        <local:ImageViewer Background="#101827" BorderThickness="0" Margin="0,0,12,0">
                            <Border CornerRadius="8" Padding="8">
                                <Image x:Name="AnnotationPreview" Stretch="Uniform" />
                            </Border>
                        </local:ImageViewer>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="识别文本" FontWeight="SemiBold" />
                            <TextBlock x:Name="AnnotationDescriptionText" Text="为当前图片填写标准答案，保存后用于训练。" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,8" />
                            <TextBox x:Name="AnnotationText" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" />
                            <TextBlock x:Name="AnnotationStatusText" Text="请选择数据集目录。" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,10,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

            <Grid x:Name="TrainingPanel" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="TrainingTitleText" Text="字符识别训练" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock x:Name="TrainingDescriptionText" Text="使用字符标注平台生成的 image/text 数据训练配置；默认基座为 PaddleOCR-VL-1.6。"
                               TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,14" />
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="数据集目录" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBox x:Name="TrainingRootText" Grid.Column="1" IsReadOnly="True" />
                        <Button Grid.Column="2" Content="选择" Click="ChooseTrainingFolder_Click" />
                    </Grid>
                    <WrapPanel Margin="0,0,0,14">
                        <TextBlock Text="训练轮数" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="TrainingEpochText" Text="20" Width="70" Margin="0,0,18,0" />
                        <TextBlock Text="批大小" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="TrainingBatchText" Text="2" Width="70" Margin="0,0,18,0" />
                        <Button x:Name="PrepareTrainingButton" Content="生成训练配置" Click="PrepareTraining_Click" />
                    </WrapPanel>
                    <Border Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1" CornerRadius="8" Padding="12">
                        <TextBlock x:Name="TrainingHintText" Text="提示：PaddleOCR-VL-1.6 是视觉语言模型，推荐使用 GPU 与官方 PaddleOCR-VL 训练/服务环境；训练配置会保存到数据集 .visionworkbench/ocr 目录。"
                                   TextWrapping="Wrap" Foreground="#9A3412" />
                    </Border>
                    <TextBlock x:Name="TrainingStatusText" Text="请选择字符识别数据集。" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,12,0,0" />
                </StackPanel>
            </Grid>

            <Grid x:Name="TestPanel" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="选择测试图片" Click="ChooseTestImage_Click" />
                    <Button x:Name="RunOcrButton" Content="执行字符识别" Click="RunOcr_Click" />
                    <TextBlock x:Name="TestImageText" Text="尚未选择图片" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>
                <Grid Grid.Row="1" MinHeight="360">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                    <local:ImageViewer Background="#101827" BorderThickness="0" Margin="0,0,12,0">
                        <Border CornerRadius="8" Padding="8">
                            <Image x:Name="TestPreview" Stretch="Uniform" />
                        </Border>
                    </local:ImageViewer>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="识别结果" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock x:Name="TestDescriptionText" Text="PaddleOCR-VL-1.6 输出的结构化结果将在这里展示。" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,8" />
                        <TextBox x:Name="TestResultText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="220" />
                        <TextBlock x:Name="TestStatusText" Text="请选择一张测试图片。" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,10,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
