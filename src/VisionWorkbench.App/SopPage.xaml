<UserControl x:Name="Root" x:Class="VisionWorkbench.App.SopPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource PageTextBlockBaseStyle}" />
        <Style x:Key="SopDataGridCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="SopDataGridHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="SopDataGridTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource PageTextBlockBaseStyle}">
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SopDataGridTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="新建SOP" Click="New_Click" />
                <Button Content="复制SOP" Click="Copy_Click" />
                <Button Content="删除" Click="Delete_Click" />
                <Button Content="保存" Click="Save_Click" />
                <Button Content="刷新" Click="Refresh_Click" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="SOP流程制作与管理" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="创建并发布 SOP 流程，配置各工序的算法和条件；发布后请到任务配置中新建任务并绑定该 SOP。"
                           Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="275" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="SOP目录" FontWeight="SemiBold" Margin="4,2,4,8" />
                    <ListBox x:Name="DefinitionList" DisplayMemberPath="DisplayName"
                             SelectionChanged="DefinitionList_SelectionChanged" />
                </DockPanel>
            </Border>

            <Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="12">
                <Grid x:Name="EditorPanel" IsEnabled="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock x:Name="StatusText" DockPanel.Dock="Right" Foreground="{DynamicResource MutedTextBrush}"
                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock Text="SOP定义" FontSize="18" FontWeight="SemiBold" />
                        </DockPanel>

                        <GroupBox Grid.Row="1" Header="基本信息" Margin="0,0,0,10">
                            <Grid Margin="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="170" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="流程名称" VerticalAlignment="Center" />
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="DefinitionNameText" Margin="4,2,12,5" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="流程编号" VerticalAlignment="Center" />
                                <TextBox Grid.Row="0" Grid.Column="3" x:Name="DefinitionCodeText" Margin="4,2,0,5" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="产品/工艺编号" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="ProductCodeText" Margin="4,2,12,5" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="版本" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="3" x:Name="VersionText" Margin="4,2,0,5" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Grid.Row="2" Header="工序步骤" Margin="0,0,0,10">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,7">
                                    <Button Content="新增步骤" Click="AddStep_Click" />
                                    <Button Content="删除步骤" Click="RemoveStep_Click" />
                                    <TextBlock Text="每个工序对应一个模型；按步骤顺序组合目标检测、OCR、条码、二维码、行为识别等模型。"
                                               Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </StackPanel>
                                <DataGrid x:Name="StepsGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                                          VerticalAlignment="Stretch" SelectionMode="Single"
                                          MinHeight="0"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          CellStyle="{StaticResource SopDataGridCellStyle}"
                                          ColumnHeaderStyle="{StaticResource SopDataGridHeaderStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="顺序" Binding="{Binding Order, UpdateSourceTrigger=LostFocus}" Width="55"
                                                            ElementStyle="{StaticResource SopDataGridTextBlockStyle}"
                                                            EditingElementStyle="{StaticResource SopDataGridTextBoxStyle}" />
                                        <DataGridTextColumn Header="步骤编号" Binding="{Binding Code, UpdateSourceTrigger=LostFocus}" Width="105"
                                                            ElementStyle="{StaticResource SopDataGridTextBlockStyle}"
                                                            EditingElementStyle="{StaticResource SopDataGridTextBoxStyle}" />
                                        <DataGridTextColumn Header="步骤名称" Binding="{Binding Name, UpdateSourceTrigger=LostFocus}" Width="*" MinWidth="120"
                                                            ElementStyle="{StaticResource SopDataGridTextBlockStyle}"
                                                            EditingElementStyle="{StaticResource SopDataGridTextBoxStyle}" />
                                        <DataGridTemplateColumn Header="模型类型" Width="145">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox SelectedValue="{Binding ModelType, UpdateSourceTrigger=PropertyChanged}"
                                                              SelectedValuePath="Tag" Padding="4,0" BorderThickness="0"
                                                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                                        <ComboBoxItem Content="目标检测" Tag="目标检测" />
                                                        <ComboBoxItem Content="语义分割" Tag="语义分割" />
                                                        <ComboBoxItem Content="实例分割" Tag="实例分割" />
                                                        <ComboBoxItem Content="行为识别" Tag="行为识别" />
                                                        <ComboBoxItem Content="AI字符识别" Tag="AI字符识别" />
                                                        <ComboBoxItem Content="AI条码识别" Tag="AI条码识别" />
                                                        <ComboBoxItem Content="AI二维码识别" Tag="AI二维码识别" />
                                                    </ComboBox>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <ComboBox SelectedValue="{Binding ModelType, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag"
                                                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                                        <ComboBoxItem Content="目标检测" Tag="目标检测" />
                                                        <ComboBoxItem Content="语义分割" Tag="语义分割" />
                                                        <ComboBoxItem Content="实例分割" Tag="实例分割" />
                                                        <ComboBoxItem Content="行为识别" Tag="行为识别" />
                                                        <ComboBoxItem Content="AI字符识别" Tag="AI字符识别" />
                                                        <ComboBoxItem Content="AI条码识别" Tag="AI条码识别" />
                                                        <ComboBoxItem Content="AI二维码识别" Tag="AI二维码识别" />
                                                    </ComboBox>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="模型ID" Binding="{Binding ModelId, UpdateSourceTrigger=LostFocus}" Width="170"
                                                            ElementStyle="{StaticResource SopDataGridTextBlockStyle}"
                                                            EditingElementStyle="{StaticResource SopDataGridTextBoxStyle}" />
                                        <DataGridTextColumn Header="类别/匹配值" Binding="{Binding ClassId, UpdateSourceTrigger=LostFocus}" Width="140"
                                                            ElementStyle="{StaticResource SopDataGridTextBlockStyle}"
                                                            EditingElementStyle="{StaticResource SopDataGridTextBoxStyle}" />
                                        <DataGridTextColumn Header="置信度" Binding="{Binding MinConfidence, UpdateSourceTrigger=LostFocus}" Width="75"
                                                            ElementStyle="{StaticResource SopDataGridTextBlockStyle}"
                                                            EditingElementStyle="{StaticResource SopDataGridTextBoxStyle}" />
                                        <DataGridTextColumn Header="稳定帧" Binding="{Binding StableFrames, UpdateSourceTrigger=LostFocus}" Width="65"
                                                            ElementStyle="{StaticResource SopDataGridTextBlockStyle}"
                                                            EditingElementStyle="{StaticResource SopDataGridTextBoxStyle}" />
                                        <DataGridTextColumn Header="超时秒" Binding="{Binding TimeoutSeconds, UpdateSourceTrigger=LostFocus}" Width="65"
                                                            ElementStyle="{StaticResource SopDataGridTextBlockStyle}"
                                                            EditingElementStyle="{StaticResource SopDataGridTextBoxStyle}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Grid.Row="2" Text="模型类型和模型 ID 用于确定步骤模型；算法运行时由系统根据模型类型自动选择。类别/匹配值用于生成对应 SOP 事件条件。"
                                           Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,7,0,0" />
                            </Grid>
                        </GroupBox>

                        <Border Grid.Row="3" Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="10">
                            <TextBlock Text="使用方式：在这里配置 SOP 流程、步骤和每步模型。保存并发布后，请到任务配置选择输入源、设备/路径、运行模式并绑定本 SOP；保存任务后，实时检测中即可选择该任务。"
                                       TextWrapping="Wrap" />
                        </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
