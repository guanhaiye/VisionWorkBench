<UserControl x:Name="Root" x:Class="VisionWorkbench.App.SopPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:VisionWorkbench.App"
             Loaded="Page_Loaded" Unloaded="Page_Unloaded">
    <UserControl.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource PageTextBlockBaseStyle}" />
        <Style x:Key="SopDataGridCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="SopDataGridHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="SopDataGridTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource PageTextBlockBaseStyle}">
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SopDataGridTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="视频录制" Click="Recording_Click" />
                <Button Content="新建SOP" Click="New_Click" />
                <Button Content="删除" Click="Delete_Click" />
                <Button Content="保存" Click="Save_Click" />
                <Button Content="刷新" Click="Refresh_Click" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="SOP流程制作与管理" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="创建并发布 SOP 流程，配置各工序的算法和条件；发布后请到任务配置中新建任务并绑定该 SOP。"
                           Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="SOP目录" FontWeight="SemiBold" Margin="4,2,4,8" />
                    <ListBox x:Name="DefinitionList"
                             SelectionChanged="DefinitionList_SelectionChanged"
                             PreviewMouseRightButtonDown="DefinitionList_PreviewMouseRightButtonDown"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             HorizontalContentAlignment="Left">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,3" ToolTip="{Binding DisplayName}">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="NoWrap" />
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="{Binding CodeAndVersion}" Foreground="{DynamicResource MutedTextBrush}"
                                                   TextWrapping="NoWrap" />
                                        <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="4"
                                                Padding="6,2" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource AccentBrush}"
                                                       FontWeight="SemiBold" TextWrapping="NoWrap" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="复制SOP" Click="Copy_Click" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid x:Name="EditorPanel" IsEnabled="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock x:Name="StatusText" DockPanel.Dock="Right" Foreground="{DynamicResource MutedTextBrush}"
                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock Text="SOP定义" FontSize="18" FontWeight="SemiBold" />
                        </DockPanel>

                        <GroupBox Grid.Row="1" Header="基本信息" Margin="0,0,0,10">
                            <Grid Margin="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="170" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="流程名称" VerticalAlignment="Center" />
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="DefinitionNameText" Margin="4,2,12,5" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="流程编号" VerticalAlignment="Center" />
                                <TextBox Grid.Row="0" Grid.Column="3" x:Name="DefinitionCodeText" Margin="4,2,0,5" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="产品/工艺编号" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="ProductCodeText" Margin="4,2,12,5" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="版本" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="3" x:Name="VersionText" Margin="4,2,0,5" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="发布状态" VerticalAlignment="Center" />
                                <ComboBox Grid.Row="2" Grid.Column="1" x:Name="DefinitionStatusCombo"
                                          DisplayMemberPath="Label" SelectedValuePath="Value"
                                          Margin="4,2,12,2" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Grid.Row="2" Header="工序步骤" Margin="0,0,0,10">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,7">
                                    <Button Content="新增步骤" Click="AddStep_Click" />
                                    <Button Content="删除步骤" Click="RemoveStep_Click" />
                                    <TextBlock Text="每个工序对应一个模型；按步骤顺序组合目标检测、OCR、条码、二维码、行为识别等模型。"
                                               Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </StackPanel>
                                <DataGrid x:Name="StepsGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                                          CanUserSortColumns="False" AllowDrop="True"
                                          VerticalAlignment="Stretch" SelectionMode="Single"
                                          PreviewMouseLeftButtonDown="StepsGrid_PreviewMouseLeftButtonDown"
                                          PreviewMouseMove="StepsGrid_PreviewMouseMove"
                                          PreviewMouseLeftButtonUp="StepsGrid_PreviewMouseLeftButtonUp"
                                          DragOver="StepsGrid_DragOver" Drop="StepsGrid_Drop"
                                          MinHeight="260"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          CellStyle="{StaticResource SopDataGridCellStyle}"
                                          ColumnHeaderStyle="{StaticResource SopDataGridHeaderStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="顺序" Binding="{Binding Order, UpdateSourceTrigger=LostFocus}" Width="55"
                                                            ElementStyle="{StaticResource SopDataGridTextBlockStyle}"
                                                            EditingElementStyle="{StaticResource SopDataGridTextBoxStyle}" />
                                        <DataGridTextColumn Header="步骤编号" Binding="{Binding Code, UpdateSourceTrigger=LostFocus}" Width="105"
                                                            ElementStyle="{StaticResource SopDataGridTextBlockStyle}"
                                                            EditingElementStyle="{StaticResource SopDataGridTextBoxStyle}" />
                                        <DataGridTextColumn Header="步骤名称" Binding="{Binding Name, UpdateSourceTrigger=LostFocus}" Width="*" MinWidth="120"
                                                            ElementStyle="{StaticResource SopDataGridTextBlockStyle}"
                                                            EditingElementStyle="{StaticResource SopDataGridTextBoxStyle}" />
                                        <DataGridTemplateColumn Header="模型类型" Width="145">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox SelectedValue="{Binding ModelType, UpdateSourceTrigger=PropertyChanged}"
                                                              SelectedValuePath="Tag" Padding="4,0" BorderThickness="0"
                                                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                                        <ComboBoxItem Content="目标检测" Tag="目标检测" />
                                                        <ComboBoxItem Content="语义分割" Tag="语义分割" />
                                                        <ComboBoxItem Content="实例分割" Tag="实例分割" />
                                                        <ComboBoxItem Content="行为识别" Tag="行为识别" />
                                                        <ComboBoxItem Content="AI字符识别" Tag="AI字符识别" />
                                                        <ComboBoxItem Content="AI条码识别" Tag="AI条码识别" />
                                                        <ComboBoxItem Content="AI二维码识别" Tag="AI二维码识别" />
                                                    </ComboBox>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <ComboBox SelectedValue="{Binding ModelType, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag"
                                                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                                        <ComboBoxItem Content="目标检测" Tag="目标检测" />
                                                        <ComboBoxItem Content="语义分割" Tag="语义分割" />
                                                        <ComboBoxItem Content="实例分割" Tag="实例分割" />
                                                        <ComboBoxItem Content="行为识别" Tag="行为识别" />
                                                        <ComboBoxItem Content="AI字符识别" Tag="AI字符识别" />
                                                        <ComboBoxItem Content="AI条码识别" Tag="AI条码识别" />
                                                        <ComboBoxItem Content="AI二维码识别" Tag="AI二维码识别" />
                                                    </ComboBox>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="类别/匹配值" Binding="{Binding ClassId, UpdateSourceTrigger=LostFocus}" Width="140"
                                                            ElementStyle="{StaticResource SopDataGridTextBlockStyle}"
                                                            EditingElementStyle="{StaticResource SopDataGridTextBoxStyle}" />
                                        <DataGridTextColumn Header="置信度" Binding="{Binding MinConfidence, UpdateSourceTrigger=LostFocus}" Width="75"
                                                            ElementStyle="{StaticResource SopDataGridTextBlockStyle}"
                                                            EditingElementStyle="{StaticResource SopDataGridTextBoxStyle}" />
                                        <DataGridTextColumn Header="稳定帧" Binding="{Binding StableFrames, UpdateSourceTrigger=LostFocus}" Width="65"
                                                            ElementStyle="{StaticResource SopDataGridTextBlockStyle}"
                                                            EditingElementStyle="{StaticResource SopDataGridTextBoxStyle}" />
                                        <DataGridTextColumn Header="超时秒" Binding="{Binding TimeoutSeconds, UpdateSourceTrigger=LostFocus}" Width="65"
                                                            ElementStyle="{StaticResource SopDataGridTextBlockStyle}"
                                                            EditingElementStyle="{StaticResource SopDataGridTextBoxStyle}" />
                                        <DataGridTemplateColumn Header="模型路径" Width="340" MinWidth="260">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Text="{Binding ModelPath}"
                                                                 IsReadOnly="True"
                                                                 ToolTip="{Binding ModelPath}"
                                                                 Padding="4,0"
                                                                 VerticalContentAlignment="Center"
                                                                 BorderThickness="0" />
                                                        <Button Grid.Column="1"
                                                                Content="选择"
                                                                Tag="{Binding}"
                                                                Click="ChooseModelPath_Click"
                                                                Padding="8,2"
                                                                MinHeight="28"
                                                                Margin="4,0,0,0" />
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Text="{Binding ModelPath, UpdateSourceTrigger=LostFocus}"
                                                                 IsReadOnly="True"
                                                                 ToolTip="{Binding ModelPath}"
                                                                 Padding="4,0"
                                                                 VerticalContentAlignment="Center" />
                                                        <Button Grid.Column="1"
                                                                Content="选择"
                                                                Tag="{Binding}"
                                                                Click="ChooseModelPath_Click"
                                                                Padding="8,2"
                                                                MinHeight="28"
                                                                Margin="4,0,0,0" />
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="录制时长（秒）" Binding="{Binding RecordingSeconds, UpdateSourceTrigger=LostFocus}" Width="105"
                                                            ElementStyle="{StaticResource SopDataGridTextBlockStyle}"
                                                            EditingElementStyle="{StaticResource SopDataGridTextBoxStyle}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Grid.Row="2" Text="模型类型用于确定步骤模型，模型路径用于选择实际模型文件；算法运行时会校验模型类型是否匹配。类别/匹配值用于生成对应 SOP 事件条件。"
                                           Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,7,0,0" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Grid.Row="3" Header="视频录制与检查" Visibility="Collapsed" Margin="0,0,0,10">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="180" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <TextBlock Text="相机" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <ComboBox x:Name="CaptureCameraCombo" Width="220">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayName}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Content="刷新" Click="RefreshCaptureCameras_Click" Margin="6,0,0,0" Padding="10,3" />
                                    <TextBlock Text="准备倒计时（秒）" VerticalAlignment="Center" Margin="16,0,6,0" />
                                    <TextBox x:Name="CapturePreparationSecondsText" Text="3" Width="55" />
                                    <Button x:Name="CaptureButton" Content="开始录制" Click="CaptureButton_Click" Margin="12,0,0,0" Padding="12,3" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Margin="0,8,0,8">
                                    <TextBlock x:Name="CaptureStepPromptText" Text="请先设置每个步骤的录制时长" FontWeight="SemiBold" />
                                    <TextBlock x:Name="CaptureCountdownText" Text="" Foreground="{DynamicResource AccentBrush}" Margin="0,3,0,0" />
                                </StackPanel>
                                <local:ImageViewer Grid.Row="2" Background="#111">
                                    <Grid>
                                        <Image x:Name="CapturePreviewImage" Stretch="Uniform" />
                                        <TextBlock x:Name="CapturePreviewHintText" Text="请选择相机并开始录制" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </local:ImageViewer>
                                <Grid Grid.Row="3" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ListBox x:Name="CaptureVideoList" DisplayMemberPath="DisplayName"
                                             SelectionChanged="CaptureVideoList_SelectionChanged" Height="120" />
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock x:Name="CaptureVideoStatusText" Text="选择已录制视频后可以检查" />
                                        <MediaElement x:Name="CaptureVideoPlayer" Height="90" Margin="0,5,0,5"
                                                      LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="播放" Click="CaptureVideoPlay_Click" Padding="10,3" />
                                            <Button Content="暂停" Click="CaptureVideoPause_Click" Margin="6,0,0,0" Padding="10,3" />
                                            <Button Content="停止" Click="CaptureVideoStop_Click" Margin="6,0,0,0" Padding="10,3" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </GroupBox>

                        <Border Grid.Row="4" Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="10">
                            <TextBlock Text="使用方式：在这里配置 SOP 流程、步骤和每步模型。保存并发布后，请到任务配置选择输入源、设备/路径、运行模式并绑定本 SOP；保存任务后，实时检测中即可选择该任务。"
                                       TextWrapping="Wrap" />
                        </Border>
                </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
