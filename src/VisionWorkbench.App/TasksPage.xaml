<UserControl x:Class="VisionWorkbench.App.TasksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左：任务列表 -->
        <DockPanel Grid.Column="0" Margin="0,0,8,0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                <Button Content="新建" Click="New_Click" />
                <Button Content="删除" Click="Delete_Click" />
                <Button Content="刷新" Click="Refresh_Click" />
            </StackPanel>
            <ListBox x:Name="TaskList" DisplayMemberPath="Name" SelectionChanged="TaskList_SelectionChanged" />
        </DockPanel>

        <!-- 右：编辑器 -->
        <ScrollViewer Grid.Column="1">
            <StackPanel x:Name="EditorPanel" IsEnabled="False">
                <GroupBox Header="基本信息">
                    <StackPanel>
                        <TextBlock Text="任务名" />
                        <TextBlock Text="工位编号（项目内唯一，随结果输出）" />
                        <TextBox x:Name="StationCodeText" Margin="0,2,0,8" MaxLength="64" />
                        <TextBox x:Name="NameText" Margin="0,2,0,8" />
                        <TextBlock Text="说明" />
                        <TextBox x:Name="DescriptionText" Margin="0,2,0,8" />
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="输入源（支持离线图片目录）">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Provider ID：" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="ProviderText" Margin="0,2,0,6"
                                 Text="image-folder" TextChanged="InputSourceTextChanged" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="图片目录：" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="DeviceText" Margin="0,2,4,6"
                                 TextChanged="InputSourceTextChanged" />
                        <Button Grid.Row="1" Grid.Column="2" x:Name="BrowseDeviceButton"
                                Content="选择目录..." Click="BrowseDevice_Click" Margin="0,2,0,6" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="DevicePreviewText"
                                   Foreground="#666" Text="尚未选择图片目录" Margin="0,0,0,6" />
                    </Grid>
                </GroupBox>
                <GroupBox Header="算法插件">
                    <StackPanel>
                        <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="插件 ID：" VerticalAlignment="Center" />
                        <ComboBox x:Name="PluginCombo" Grid.Column="1" SelectionChanged="PluginCombo_SelectionChanged" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="推理设备：" VerticalAlignment="Center" />
                            <ComboBox x:Name="ExecutionProviderCombo" Width="180">
                                <ComboBoxItem Content="CPU" Tag="cpu" />
                                <ComboBoxItem Content="CUDA（GPU）" Tag="cuda" />
                            </ComboBox>
                        </StackPanel>
                        <TextBlock Text="CUDA 需要已安装可用的 NVIDIA 驱动和 CUDA 版推理环境。"
                                   Foreground="#666" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </GroupBox>
                <GroupBox x:Name="ModelGroup" Header="模型导入与选择" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="任务类型：" VerticalAlignment="Center" />
                        <ComboBox x:Name="YoloTaskCombo" Grid.Row="0" Grid.Column="1" Margin="4,2,0,6"
                                  SelectionChanged="YoloTaskCombo_SelectionChanged">
                            <ComboBoxItem Content="目标检测" Tag="detect" />
                            <ComboBoxItem Content="实例分割" Tag="instance" />
                            <ComboBoxItem Content="语义分割" Tag="semantic" />
                        </ComboBox>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="模型文件：" VerticalAlignment="Center" />
                        <ComboBox x:Name="ModelCombo" Grid.Row="1" Grid.Column="1" Margin="4,2,4,6" />
                        <Button Grid.Row="1" Grid.Column="2" x:Name="ImportModelButton"
                                Content="导入模型..." Click="ImportModel_Click" Margin="0,2,0,6" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ModelStatusText"
                                   Foreground="#666" Text="请选择或导入模型文件（.pt/.onnx）" Margin="4,0,0,6" />
                    </Grid>
                </GroupBox>
                <GroupBox Header="计数模式">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="模式：" VerticalAlignment="Center" />
                            <ComboBox x:Name="ModeCombo" Width="220" SelectionChanged="ModeCombo_SelectionChanged">
                                <ComboBoxItem Content="快照（静态计数）" Tag="Snapshot" IsSelected="True" />
                                <ComboBoxItem Content="动态去重（新目标累计一次）" Tag="UniqueTracking" />
                                <ComboBoxItem Content="跨线计数（穿过检测线，含方向）" Tag="LineCrossing" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel x:Name="LinePanel" Orientation="Horizontal" Margin="0,6,0,0" IsEnabled="False">
                            <TextBlock Text="检测线" VerticalAlignment="Center" />
                            <TextBlock Text="AX" VerticalAlignment="Center" Margin="8,0,2,0" />
                            <TextBox x:Name="LineAxText" Width="52" Text="0.5" Margin="0,0,4,0" />
                            <TextBlock Text="AY" VerticalAlignment="Center" Margin="4,0,2,0" />
                            <TextBox x:Name="LineAyText" Width="52" Text="0.1" Margin="0,0,4,0" />
                            <TextBlock Text="BX" VerticalAlignment="Center" Margin="4,0,2,0" />
                            <TextBox x:Name="LineBxText" Width="52" Text="0.5" Margin="0,0,4,0" />
                            <TextBlock Text="BY" VerticalAlignment="Center" Margin="4,0,2,0" />
                            <TextBox x:Name="LineByText" Width="52" Text="0.9" Margin="0,0,8,0" />
                            <TextBlock Text="滞回宽度" VerticalAlignment="Center" Margin="4,0,2,0" />
                            <TextBox x:Name="HysteresisText" Width="52" Text="0.02" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
                <GroupBox x:Name="AdvancedSettingsGroup" Header="专家选项：插件参数（JSON）">
                    <StackPanel>
                        <TextBlock x:Name="AdvancedHintText" Foreground="#996600" TextWrapping="Wrap" />
                    <TextBox x:Name="SettingsText" Height="72" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" Text="{}" />
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="ROI（归一化 0~1；全部 0 表示整幅图）">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="X" VerticalAlignment="Center" />
                        <TextBox x:Name="RoiXText" Width="56" Text="0" Margin="4,0,12,0" />
                        <TextBlock Text="Y" VerticalAlignment="Center" />
                        <TextBox x:Name="RoiYText" Width="56" Text="0" Margin="4,0,12,0" />
                        <TextBlock Text="W" VerticalAlignment="Center" />
                        <TextBox x:Name="RoiWText" Width="56" Text="0" Margin="4,0,12,0" />
                        <TextBlock Text="H" VerticalAlignment="Center" />
                        <TextBox x:Name="RoiHText" Width="56" Text="0" Margin="4,0,12,0" />
                        <TextBlock Text="边界策略" VerticalAlignment="Center" Margin="12,0,4,0" />
                        <ComboBox x:Name="RoiPolicyCombo" Width="130">
                            <ComboBoxItem Content="中心点在内" Tag="CenterInside" IsSelected="True" />
                            <ComboBoxItem Content="完整框在内" Tag="FullInside" />
                            <ComboBoxItem Content="任意重叠" Tag="AnyOverlap" />
                        </ComboBox>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="判定规则（RUL-001~005）">
                    <DataGrid x:Name="RulesGrid" AutoGenerateColumns="False" CanUserAddRows="True"
                              CanUserDeleteRows="True" MinHeight="120" Height="180">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="规则ID" Binding="{Binding RuleId}" Width="110" />
                            <DataGridComboBoxColumn Header="类型" SelectedItemBinding="{Binding Kind}" Width="130">
                                <DataGridComboBoxColumn.ItemsSource>
                                    <x:Array Type="{x:Type sys:String}"
                                             xmlns:sys="clr-namespace:System;assembly=mscorlib">
                                        <sys:String>CountEquals</sys:String>
                                        <sys:String>CountAtLeast</sys:String>
                                        <sys:String>CountAtMost</sys:String>
                                        <sys:String>ClassRequired</sys:String>
                                        <sys:String>ClassForbidden</sys:String>
                                        <sys:String>LowConfidence</sys:String>
                                    </x:Array>
                                </DataGridComboBoxColumn.ItemsSource>
                            </DataGridComboBoxColumn>
                            <DataGridTextColumn Header="类别" Binding="{Binding ClassId}" Width="90" />
                            <DataGridTextColumn Header="期望数量" Binding="{Binding ExpectedCount}" Width="70" />
                            <DataGridTextColumn Header="最低置信度" Binding="{Binding MinConfidence}" Width="80" />
                            <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled}" Width="50" />
                            <DataGridCheckBoxColumn Header="失败转待确认" Binding="{Binding DowngradeToReview}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
                <StackPanel Orientation="Horizontal" Margin="0,8">
                    <Button x:Name="SaveButton" Content="保存" Click="Save_Click" MinWidth="96" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
