<UserControl x:Class="VisionWorkbench.App.TasksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:VisionWorkbench.App">
    <UserControl.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource PageTextBlockBaseStyle}" />
    </UserControl.Resources>
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" MinWidth="220" />
            <ColumnDefinition Width="2*" MinWidth="360" />
            <ColumnDefinition Width="4*" MinWidth="480" />
        </Grid.ColumnDefinitions>

        <!-- 左：任务列表 -->
        <DockPanel Grid.Column="0" Margin="0,0,8,0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                <Button x:Name="NewButton" Content="新建" Click="New_Click" />
                <Button Content="删除" Click="Delete_Click" />
                <Button Content="刷新" Click="Refresh_Click" />
            </StackPanel>
            <ListBox x:Name="TaskList" DisplayMemberPath="Name" SelectionChanged="TaskList_SelectionChanged" />
        </DockPanel>

        <!-- 右：编辑器 -->
        <ScrollViewer x:Name="TaskEditorScrollViewer" Grid.Column="1">
            <StackPanel x:Name="EditorPanel" IsEnabled="False">
                <GroupBox Header="基本信息">
                    <StackPanel>
                        <TextBlock Text="任务名" />
                        <TextBlock Text="工位编号（项目内唯一，随结果输出）" />
                        <TextBox x:Name="StationCodeText" Margin="0,2,0,8" MaxLength="64" />
                        <TextBox x:Name="NameText" Margin="0,2,0,8" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="任务类型：" VerticalAlignment="Center" />
                            <ComboBox x:Name="TaskTypeCombo" Width="180" Margin="8,0,0,0"
                                      SelectionChanged="TaskTypeCombo_SelectionChanged">
                                <ComboBoxItem Content="请选择任务类型" Tag="" IsSelected="True" />
                                <ComboBoxItem Content="目标检测" Tag="Detection" />
                                <ComboBoxItem Content="语义分割" Tag="SemanticSegmentation" />
                                <ComboBoxItem Content="实例分割" Tag="InstanceSegmentation" />
                                <ComboBoxItem Content="行为识别" Tag="BehaviorRecognition" />
                                <ComboBoxItem Content="AI字符识别" Tag="AiText" />
                                <ComboBoxItem Content="AI条码识别" Tag="Barcode" />
                                <ComboBoxItem Content="AI二维码识别" Tag="QrCode" />
                                <ComboBoxItem Content="SOP流程" Tag="Sop" />
                            </ComboBox>
                        </StackPanel>
                        <GroupBox x:Name="SopBindingGroup" Header="SOP流程绑定" Visibility="Collapsed" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="已发布SOP：" VerticalAlignment="Center" />
                                <ComboBox x:Name="SopCombo" Grid.Column="1" Margin="8,2,0,2"
                                          DisplayMemberPath="DisplayName"
                                          SelectionChanged="SopCombo_SelectionChanged" />
                                <TextBlock x:Name="SopBindingHintText" Grid.Row="1" Grid.Column="1"
                                           Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                                           Margin="8,4,0,2"
                                           Text="SOP 页面只维护流程和步骤模型；输入源、设备/路径及运行模式在本任务中配置。" />
                                <TextBlock Grid.Row="2" Text="运行模式：" VerticalAlignment="Center" />
                                <ComboBox x:Name="SopRunModeCombo" Grid.Row="2" Grid.Column="1" Margin="8,2,0,2">
                                    <ComboBoxItem Content="严格按顺序" Tag="StrictOrder" IsSelected="True" />
                                    <ComboBoxItem Content="允许跳步" Tag="AllowSkip" />
                                    <ComboBoxItem Content="人工确认" Tag="ManualReview" />
                                </ComboBox>
                            </Grid>
                        </GroupBox>
                        <TextBlock Text="说明" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="触发源" VerticalAlignment="Center" />
                            <ComboBox x:Name="TcpTriggerProfileCombo" Width="220" Margin="8,0,0,0" DisplayMemberPath="Name" />
                        </StackPanel>
                        <TextBox x:Name="DescriptionText" Margin="0,2,0,8" />
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="输入源（图片、视频、网络相机或 USB 相机）">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="输入源：" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="ProviderCombo" Margin="0,2,0,6"
                                  DisplayMemberPath="DisplayName" SelectionChanged="ProviderCombo_SelectionChanged" />
                        <TextBlock Grid.Row="1" Grid.Column="0" x:Name="DevicePathLabel" Text="图片目录：" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="DeviceText" Margin="0,2,4,6"
                                 TextChanged="InputSourceTextChanged" />
                        <Button Grid.Row="1" Grid.Column="2" x:Name="BrowseDeviceButton"
                                Content="选择目录..." Click="BrowseDevice_Click" Margin="0,2,0,6" />
                        <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" x:Name="CameraPreviewPanel"
                                Visibility="Collapsed" Background="#111" BorderBrush="#555" BorderThickness="1"
                                Height="230" Margin="0,4,0,8">
                            <local:ImageViewer Background="#111" BorderBrush="#555" BorderThickness="1">
                                <Grid>
                                    <Image x:Name="CameraPreviewImage" Stretch="Uniform" />
                                    <TextBlock x:Name="CameraPreviewStatusText" Text="正在准备相机预览..."
                                               Foreground="White" Background="#99000000" Padding="8"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </local:ImageViewer>
                        </Border>
                        <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="DevicePreviewText"
                                   Foreground="#666" Text="尚未选择图片目录" Margin="0,0,0,6" />
                    </Grid>
                </GroupBox>
                <GroupBox x:Name="HikvisionCameraSettingsGroup" Header="海康相机参数（可选）" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="宽度" VerticalAlignment="Center" />
                        <TextBox x:Name="HikWidthText" Grid.Column="1" Margin="6,2,14,4" />
                        <TextBlock Grid.Column="2" Text="高度" VerticalAlignment="Center" />
                        <TextBox x:Name="HikHeightText" Grid.Column="3" Margin="6,2,14,4" />
                        <TextBlock Grid.Column="4" Text="帧率" VerticalAlignment="Center" />
                        <TextBox x:Name="HikFrameRateText" Grid.Column="5" Margin="6,2,0,4" />
                        <TextBlock Grid.Row="1" Text="曝光（μs）" VerticalAlignment="Center" />
                        <TextBox x:Name="HikExposureText" Grid.Row="1" Grid.Column="1" Margin="6,2,14,4" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="增益（dB）" VerticalAlignment="Center" />
                        <TextBox x:Name="HikGainText" Grid.Row="1" Grid.Column="3" Margin="6,2,14,4" />
                        <TextBlock Grid.Row="1" Grid.Column="4" Text="触发模式" VerticalAlignment="Center" />
                        <ComboBox x:Name="HikTriggerModeCombo" Grid.Row="1" Grid.Column="5" Margin="6,2,0,4">
                            <ComboBoxItem Content="连续采集" Tag="off" IsSelected="True" />
                            <ComboBoxItem Content="硬件/软件触发" Tag="on" />
                        </ComboBox>
                        <TextBlock Grid.Row="2" Text="触发源" VerticalAlignment="Center" />
                        <ComboBox x:Name="HikTriggerSourceCombo" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="6,2,14,2">
                            <ComboBoxItem Content="线路 0" Tag="Line0" IsSelected="True" />
                            <ComboBoxItem Content="软件触发" Tag="Software" />
                        </ComboBox>
                        <TextBlock Grid.Row="2" Grid.Column="4" Grid.ColumnSpan="2" Text="留空表示使用相机当前参数；具体上限由相机型号决定。" Foreground="#666" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </Grid>
                </GroupBox>
                <GroupBox x:Name="AlgorithmGroup" Header="算法插件">
                    <StackPanel>
                        <Grid x:Name="GeneralPluginSelectorPanel">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="插件 ID：" VerticalAlignment="Center" />
                        <ComboBox x:Name="PluginCombo" Grid.Column="1" SelectionChanged="PluginCombo_SelectionChanged" />
                        </Grid>
                        <TextBlock x:Name="SemanticPluginFixedText"
                                   Text="ATU5/FPN 语义分割（自动选择）"
                                   Visibility="Collapsed"
                                   Foreground="#2E7D32"
                                   Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="推理设备：" VerticalAlignment="Center" />
                            <ComboBox x:Name="ExecutionProviderCombo" Width="180">
                                <ComboBoxItem Content="CPU" Tag="cpu" />
                                <ComboBoxItem Content="CUDA（GPU）" Tag="cuda" />
                            </ComboBox>
                        </StackPanel>
                        <TextBlock Text="CUDA 需要已安装可用的 NVIDIA 驱动和 CUDA 版推理环境。"
                                   Foreground="#666" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </GroupBox>
                <GroupBox x:Name="ModelGroup" Header="模型导入与选择" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="YoloTaskLabel" Grid.Row="0" Grid.Column="0" Text="任务类型：" VerticalAlignment="Center" />
                        <ComboBox x:Name="YoloTaskCombo" Grid.Row="0" Grid.Column="1" Margin="4,2,0,6"
                                  SelectionChanged="YoloTaskCombo_SelectionChanged">
                            <ComboBoxItem Content="目标检测" Tag="detect" />
                            <ComboBoxItem Content="实例分割" Tag="instance" />
                            <ComboBoxItem Content="语义分割" Tag="semantic" />
                        </ComboBox>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="模型文件：" VerticalAlignment="Center" />
                        <ComboBox x:Name="ModelCombo" Grid.Row="1" Grid.Column="1" Margin="4,2,4,6" />
                        <Button Grid.Row="1" Grid.Column="2" x:Name="ImportModelButton"
                                Content="导入模型..." Click="ImportModel_Click" Margin="0,2,0,6" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ModelStatusText"
                                   Foreground="#666" Text="请选择或导入模型文件（.engine/.pt/.onnx）" Margin="4,0,0,6" />
                    </Grid>
                </GroupBox>
                <GroupBox Header="计数模式">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="模式：" VerticalAlignment="Center" />
                            <ComboBox x:Name="ModeCombo" Width="220" SelectionChanged="ModeCombo_SelectionChanged">
                                <ComboBoxItem Content="快照（静态计数）" Tag="Snapshot" IsSelected="True" />
                                <ComboBoxItem Content="动态去重（新目标累计一次）" Tag="UniqueTracking" />
                                <ComboBoxItem Content="跨线计数（穿过检测线，含方向）" Tag="LineCrossing" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel x:Name="LinePanel" Orientation="Horizontal" Margin="0,6,0,0" IsEnabled="False">
                            <TextBlock Text="检测线" VerticalAlignment="Center" />
                            <TextBlock Text="AX" VerticalAlignment="Center" Margin="8,0,2,0" />
                            <TextBox x:Name="LineAxText" Width="52" Text="0.5" Margin="0,0,4,0" />
                            <TextBlock Text="AY" VerticalAlignment="Center" Margin="4,0,2,0" />
                            <TextBox x:Name="LineAyText" Width="52" Text="0.1" Margin="0,0,4,0" />
                            <TextBlock Text="BX" VerticalAlignment="Center" Margin="4,0,2,0" />
                            <TextBox x:Name="LineBxText" Width="52" Text="0.5" Margin="0,0,4,0" />
                            <TextBlock Text="BY" VerticalAlignment="Center" Margin="4,0,2,0" />
                            <TextBox x:Name="LineByText" Width="52" Text="0.9" Margin="0,0,8,0" />
                            <TextBlock Text="滞回宽度" VerticalAlignment="Center" Margin="4,0,2,0" />
                            <TextBox x:Name="HysteresisText" Width="52" Text="0.02" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="ROI（归一化 0~1；全部 0 表示整幅图）">
                    <StackPanel>
                        <WrapPanel>
                            <TextBlock Text="X" VerticalAlignment="Center" />
                            <TextBox x:Name="RoiXText" Width="56" Text="0" Margin="4,0,12,0" TextChanged="RoiInput_TextChanged" />
                            <TextBlock Text="Y" VerticalAlignment="Center" />
                            <TextBox x:Name="RoiYText" Width="56" Text="0" Margin="4,0,12,0" TextChanged="RoiInput_TextChanged" />
                            <TextBlock Text="W" VerticalAlignment="Center" />
                            <TextBox x:Name="RoiWText" Width="56" Text="0" Margin="4,0,12,0" TextChanged="RoiInput_TextChanged" />
                            <TextBlock Text="H" VerticalAlignment="Center" />
                            <TextBox x:Name="RoiHText" Width="56" Text="0" Margin="4,0,12,0" TextChanged="RoiInput_TextChanged" />
                            <TextBlock Text="边界策略" VerticalAlignment="Center" Margin="12,0,4,0" />
                            <ComboBox x:Name="RoiPolicyCombo" Width="130">
                                <ComboBoxItem Content="中心点在内" Tag="CenterInside" IsSelected="True" />
                                <ComboBoxItem Content="完整框在内" Tag="FullInside" />
                                <ComboBoxItem Content="任意重叠" Tag="AnyOverlap" />
                            </ComboBox>
                        </WrapPanel>
                        <Border Background="#111" BorderBrush="#555" BorderThickness="1" Height="260" Margin="0,10,0,6">
                            <Grid x:Name="RoiPreviewSurface"
                                  MouseLeftButtonDown="RoiPreviewSurface_MouseLeftButtonDown"
                                  MouseMove="RoiPreviewSurface_MouseMove"
                                  MouseLeftButtonUp="RoiPreviewSurface_MouseLeftButtonUp"
                                  SizeChanged="RoiPreviewSurface_SizeChanged">
                                <Image x:Name="RoiPreviewImage" Stretch="Uniform" />
                                <Canvas x:Name="RoiCanvas" IsHitTestVisible="False" />
                                <TextBlock x:Name="RoiPreviewStatusText" Text="请选择输入源或相机预览后，在此区域拖动鼠标绘制 ROI"
                                           Foreground="White" Background="#99000000" Padding="8"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                        <WrapPanel>
                            <Button x:Name="RoiDrawButton" Content="绘制 ROI" Click="RoiDraw_Click" Padding="12,5" />
                            <Button x:Name="RoiClearButton" Content="清除 ROI" Click="RoiClear_Click" Margin="8,0,0,0" Padding="12,5" IsEnabled="False" />
                            <TextBlock Text="拖动鼠标框选区域，坐标会自动同步到上方。" Foreground="{DynamicResource MutedTextBrush}"
                                       VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" />
                        </WrapPanel>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="判定规则（RUL-001~005）">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="后处理方式" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <StackPanel Orientation="Horizontal">
                                <ComboBox x:Name="PostProcessModeCombo" Width="150"
                                          SelectionChanged="PostProcessMode_SelectionChanged">
                                    <ComboBoxItem Content="可视化规则" Tag="VisualRules" IsSelected="True" />
                                    <ComboBoxItem Content="Python 脚本" Tag="PythonScript" />
                                </ComboBox>
                                <Button x:Name="EditPostProcessScriptButton" Content="编辑 Python 脚本"
                                        Click="EditPostProcessScript_Click" Margin="8,0,0,0"
                                        Padding="12,5" IsEnabled="False" />
                            </StackPanel>
                            <TextBlock x:Name="PostProcessHintText" Margin="0,5,0,0"
                                       Text="使用面积、直径、数量等可视化规则进行筛选。"
                                       Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button x:Name="AddRuleButton" Content="＋ 添加规则" Click="AddRule_Click" HorizontalAlignment="Left"
                                Margin="0,0,0,8" Padding="12,5" />
                        <DataGrid x:Name="RulesGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserDeleteRows="True" MinHeight="120" Height="180"
                              Background="{DynamicResource SurfaceBrush}"
                              Foreground="{DynamicResource TextBrush}"
                              RowBackground="{DynamicResource SurfaceBrush}"
                              AlternatingRowBackground="{DynamicResource SurfaceAltBrush}">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="规则ID" Binding="{Binding RuleId}" Width="110" />
                            <DataGridComboBoxColumn Header="类型" SelectedItemBinding="{Binding Kind}" Width="130">
                                <DataGridComboBoxColumn.ItemsSource>
                                    <x:Array Type="{x:Type sys:String}"
                                             xmlns:sys="clr-namespace:System;assembly=mscorlib">
                                        <sys:String>CountEquals</sys:String>
                                        <sys:String>CountAtLeast</sys:String>
                                        <sys:String>CountAtMost</sys:String>
                                        <sys:String>ClassRequired</sys:String>
                                        <sys:String>ClassForbidden</sys:String>
                                        <sys:String>LowConfidence</sys:String>
                                        <sys:String>AreaRange</sys:String>
                                        <sys:String>DiameterRange</sys:String>
                                        <sys:String>CountRange</sys:String>
                                    </x:Array>
                                </DataGridComboBoxColumn.ItemsSource>
                            </DataGridComboBoxColumn>
                            <DataGridTextColumn Header="最小值" Binding="{Binding Minimum, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                            <DataGridTextColumn Header="最大值" Binding="{Binding Maximum, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                            <DataGridTextColumn Header="类别（ID）" Binding="{Binding ClassId}" Width="90" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="期望数量" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ExpectedCount}" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="CountEquals"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="CountAtLeast"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="CountAtMost"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding ExpectedCount, UpdateSourceTrigger=PropertyChanged}">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="CountEquals"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="CountAtLeast"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="CountAtMost"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="最低置信度" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding MinConfidence}" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="LowConfidence"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding MinConfidence, UpdateSourceTrigger=PropertyChanged}">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="LowConfidence"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled}" Width="50" />
                            <DataGridTemplateColumn Header="失败转待确认" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding DowngradeToReview}" HorizontalAlignment="Center">
                                            <CheckBox.Style>
                                                <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="AreaRange"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="DiameterRange"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="CountRange"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </CheckBox.Style>
                                        </CheckBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding DowngradeToReview}" HorizontalAlignment="Center">
                                            <CheckBox.Style>
                                                <Style TargetType="CheckBox">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="AreaRange"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="DiameterRange"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="CountRange"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </CheckBox.Style>
                                        </CheckBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </GroupBox>
                <GroupBox x:Name="BehaviorGroup" Header="行为识别（自定义模型/规则）">
                    <StackPanel>
                        <CheckBox x:Name="BehaviorEnabledCheck" Content="启用行为识别" IsChecked="False" />
                        <TextBlock x:Name="CustomBehaviorModelStatusText" Foreground="DarkGreen" TextWrapping="Wrap" Margin="0,4,0,2" Visibility="Collapsed" />
                        <WrapPanel x:Name="CustomBehaviorClassesPanel" Margin="0,2,0,4" Visibility="Collapsed" />
                        <TextBlock Text="监控区域多边形（归一化坐标，点格式 x,y；点之间用分号分隔）" Margin="0,6,0,2" TextWrapping="Wrap" />
                        <TextBox x:Name="BehaviorPolygonText" Text="0.1,0.1;0.9,0.1;0.9,0.9;0.1,0.9" />
                        <TextBlock x:Name="BuiltInBehaviorRulesTitle" Text="启用内置规则" Margin="0,6,0,2" />
                        <StackPanel x:Name="BuiltInBehaviorRulesPanel" Orientation="Horizontal">
                            <CheckBox x:Name="IntrusionEnabledCheck" Content="侵入" IsChecked="True" Margin="0,0,12,0" />
                            <CheckBox x:Name="LoiteringEnabledCheck" Content="徘徊" IsChecked="True" Margin="0,0,12,0" />
                            <CheckBox x:Name="CrowdingEnabledCheck" Content="聚集" IsChecked="True" Margin="0,0,12,0" />
                            <CheckBox x:Name="FallEnabledCheck" Content="跌倒（需 Pose）" IsChecked="False" />
                        </StackPanel>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="72" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="确认秒数" VerticalAlignment="Center" />
                            <TextBox x:Name="BehaviorConfirmingSecondsText" Grid.Row="0" Grid.Column="1" Text="0.5" Margin="4,2,8,2" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="徘徊预警秒数" VerticalAlignment="Center" />
                            <TextBox x:Name="BehaviorLoiterWarningSecondsText" Grid.Row="0" Grid.Column="3" Text="30" Margin="4,2,8,2" />
                            <TextBlock Grid.Row="0" Grid.Column="4" Text="徘徊报警秒数" VerticalAlignment="Center" />
                            <TextBox x:Name="BehaviorLoiterAlarmSecondsText" Grid.Row="0" Grid.Column="5" Text="60" Margin="4,2,0,2" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="聚集预警人数" VerticalAlignment="Center" />
                            <TextBox x:Name="BehaviorCrowdWarningCountText" Grid.Row="1" Grid.Column="1" Text="5" Margin="4,2,8,2" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="聚集报警人数" VerticalAlignment="Center" />
                            <TextBox x:Name="BehaviorCrowdAlarmCountText" Grid.Row="1" Grid.Column="3" Text="8" Margin="4,2,8,2" />
                            <TextBlock Grid.Row="1" Grid.Column="4" Text="最低置信度" VerticalAlignment="Center" />
                            <TextBox x:Name="BehaviorConfidenceText" Grid.Row="1" Grid.Column="5" Text="0.5" Margin="4,2,0,2" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="行为时序模型" VerticalAlignment="Center" />
                            <ComboBox x:Name="TemporalModelTypeCombo" Width="100" Margin="6,0,8,0">
                                <ComboBoxItem Content="ST-GCN" Tag="stgcn" IsSelected="True" />
                                <ComboBoxItem Content="PoseC3D" Tag="posec3d" />
                            </ComboBox>
                            <TextBlock Text="模型路径" VerticalAlignment="Center" />
                            <TextBox x:Name="TemporalModelPathText" Width="420" Margin="6,0,6,0" TextChanged="TemporalModelPathText_TextChanged" />
                            <Button x:Name="BrowseTemporalModelButton" Content="导入行为模型..." Click="ImportTemporalModel_Click" />
                        </StackPanel>
                        <TextBlock Text="行为任务使用顶部 YOLO11-Pose 模型提取人体关键点，再使用下方行为时序模型进行自定义行为识别。模型目录应同时包含 classes.json；未加载自定义模型时才使用内置规则。" Foreground="#666" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </GroupBox>
                <StackPanel Orientation="Horizontal" Margin="0,8">
                    <Button x:Name="SaveButton" Content="保存" Click="Save_Click" MinWidth="96" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- 测试区：读取多张图片，逐张使用当前选中任务的配置执行测试。 -->
        <Border Grid.Column="2" Margin="8,0,0,0"
                Padding="10"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="ReadTestImageButton" Content="读取图片"
                            Click="ReadTestImage_Click" Padding="12,5" />
                    <Button x:Name="TaskTestPreviousButton" Content="上一张"
                            Click="TaskTestPrevious_Click" Padding="12,5" Margin="8,0,0,0"
                            IsEnabled="False" />
                    <Button x:Name="TaskTestNextButton" Content="下一张"
                            Click="TaskTestNext_Click" Padding="12,5" Margin="8,0,0,0"
                            IsEnabled="False" />
                    <Button x:Name="RunTaskTestButton" Content="测试"
                            Click="RunTaskTest_Click" Padding="16,5" Margin="8,0,0,0"
                            IsEnabled="False" />
                    <CheckBox x:Name="AutoTaskTestCheck" Content="自动测试"
                              Checked="AutoTaskTestCheck_Checked"
                              Unchecked="AutoTaskTestCheck_Unchecked"
                              Margin="12,0,0,0"
                              VerticalAlignment="Center"
                              IsEnabled="False" />
                </StackPanel>
                <Border Grid.Row="1" Margin="0,10,0,8"
                        Background="#111111"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1">
                    <Grid x:Name="TaskTestPreviewSurface"
                          SizeChanged="TaskTestPreviewSurface_SizeChanged">
                        <Image x:Name="TaskTestImage" Stretch="Uniform" />
                        <Canvas x:Name="TaskTestOverlayCanvas" IsHitTestVisible="False" />
                        <TextBlock x:Name="TaskTestImageIndexText"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"
                                   Margin="8"
                                   Foreground="White"
                                   Background="#99000000"
                                   Padding="8,4"
                                   Visibility="Collapsed" />
                        <TextBlock x:Name="TaskTestStatusText"
                                   Text="请先读取测试图片"
                                   Foreground="White"
                                   Background="#99000000"
                                   Padding="8"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                    </Grid>
                </Border>
                <TextBlock x:Name="TaskTestResultText" Grid.Row="2"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="未执行测试"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
