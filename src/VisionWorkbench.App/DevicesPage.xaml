<UserControl x:Class="VisionWorkbench.App.DevicesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:VisionWorkbench.App">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,6">
            <Button Content="扫描设备" Click="Scan_Click" />
            <TextBlock Text="USB 用 DSHOW 索引探测；图片/视频为虚拟源，用任务配置里的路径直接打开"
                       VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#888" />
        </DockPanel>
        <DataGrid x:Name="DevicesGrid" Grid.Row="1" Height="180" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionChanged="DevicesGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Provider" Binding="{Binding ProviderId}" Width="120" />
                <DataGridTextColumn Header="设备 ID" Binding="{Binding DeviceId}" Width="*" />
                <DataGridTextColumn Header="名称" Binding="{Binding DisplayName}" Width="260" />
            </DataGrid.Columns>
        </DataGrid>
        <GroupBox x:Name="HikvisionSettingsGroup" Grid.Row="2" Header="海康工业相机设置" Visibility="Collapsed" Margin="0,0,0,6">
            <Grid Margin="8,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="SelectedDeviceText" TextWrapping="Wrap" Foreground="#555" />
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="曝光时间（μs）" VerticalAlignment="Center" />
                    <TextBox x:Name="ExposureText" Width="140" Margin="8,0,8,0" />
                    <Button Content="设置曝光" Click="ApplyExposure_Click" />
                    <Button Content="保存设置" Click="SaveExposure_Click" Margin="8,0,0,0" />
                    <TextBlock x:Name="ExposureStatusText" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#555" />
                </StackPanel>
            </Grid>
        </GroupBox>
        <GroupBox Grid.Row="3" Header="测试预览（打开 5 秒后自动关闭）">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button Content="测试选中设备" Click="Test_Click" />
                    <TextBlock x:Name="TestStatusText" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
                <local:ImageViewer Grid.Row="1" Background="#111" Margin="0,6,0,0">
                    <Image x:Name="TestPreviewImage" Stretch="Uniform" />
                </local:ImageViewer>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
