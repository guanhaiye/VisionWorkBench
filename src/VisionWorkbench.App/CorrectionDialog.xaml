<Window x:Class="VisionWorkbench.App.CorrectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="人工修正" Width="420" SizeToContent="Height"
        Style="{StaticResource ThemedDialogWindow}"
        WindowStartupLocation="CenterOwner">
    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="6" Direction="270"
                              Opacity="0.18" Color="#334155" />
        </Border.Effect>
        <StackPanel>
        <TextBlock x:Name="PromptText" Text="修正内容" FontWeight="Bold" Margin="0,0,0,8" />
        <StackPanel x:Name="DeltaPanel" Orientation="Horizontal" Margin="0,4">
            <TextBlock Text="调整量：" VerticalAlignment="Center" />
            <TextBox x:Name="DeltaText" Text="1" Width="60" />
            <TextBlock Text="（+1 / -1 / ±n）" Foreground="#888" VerticalAlignment="Center" Margin="8,0,0,0" />
        </StackPanel>
        <TextBlock Text="修正原因（必填，CNT-S-010）：" Margin="0,8,0,4" />
        <TextBox x:Name="ReasonText" Height="72" TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="确定" Click="Ok_Click" MinWidth="72" />
            <Button Content="取消" IsCancel="True" MinWidth="72" Margin="8,0,0,0" />
        </StackPanel>
        </StackPanel>
    </Border>
</Window>
