<Window x:Class="VisionWorkbench.App.Shell"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VisionWorkbench — AI 视觉工作台" Width="1280" Height="800"
        WindowStartupLocation="CenterScreen">
    <Window.Icon>
        <BitmapImage UriSource="/Assets/Branding/visionworkbench-taskbar.ico" />
    </Window.Icon>
    <Window.Resources>
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="#DCE8FF" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#E8E8E8" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A3D49" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1769AA" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#292A32">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <Image Source="/Assets/Branding/visionworkbench-logo-v1.png"
                           Width="82" Height="82" Stretch="Uniform" HorizontalAlignment="Center"
                           Margin="0,14,0,2" />
                    <TextBlock Text="VisionWorkbench" Foreground="White" FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="8,2,8,14" />
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Expander Header="工作台" IsExpanded="True" Foreground="White" Margin="0,2,0,0">
                            <ListBox Background="Transparent" BorderThickness="0" SelectionChanged="NavList_SelectionChanged">
                                <ListBoxItem Content="实时检测" Tag="live" />
                                <ListBoxItem Content="任务配置" Tag="tasks" />
                                <ListBoxItem Content="项目与工位" Tag="stations" />
                            </ListBox>
                        </Expander>
                        <Expander Header="数据与模型" IsExpanded="True" Foreground="White" Margin="0,2,0,0">
                            <ListBox Background="Transparent" BorderThickness="0" SelectionChanged="NavList_SelectionChanged">
                                <ListBoxItem Content="目标检测标注" Tag="detection-annotation" />
                                <ListBoxItem Content="分割标注" Tag="segmentation-annotation" />
                                <ListBoxItem Content="YOLO11 训练平台" Tag="training" />
                                <ListBoxItem Content="行为标注平台" Tag="behavior-annotation" />
                                <ListBoxItem Content="行为训练平台" Tag="behavior-training" />
                            </ListBox>
                        </Expander>
                        <Expander Header="结果查看" IsExpanded="True" Foreground="White" Margin="0,2,0,0">
                            <ListBox Background="Transparent" BorderThickness="0" SelectionChanged="NavList_SelectionChanged">
                                <ListBoxItem Content="历史记录" Tag="history" />
                                <ListBoxItem Content="SPC 结果图" Tag="spc" />
                                <ListBoxItem Content="日志管理" Tag="logs" />
                            </ListBox>
                        </Expander>
                        <Expander Header="通讯管理" IsExpanded="False" Foreground="White" Margin="0,2,0,0">
                            <ListBox Background="Transparent" BorderThickness="0" SelectionChanged="NavList_SelectionChanged">
                                <ListBoxItem Content="TCP/IP 通讯" Tag="communication" />
                            </ListBox>
                        </Expander>
                        <Expander Header="系统管理" IsExpanded="False" Foreground="White" Margin="0,2,0,0">
                            <ListBox Background="Transparent" BorderThickness="0" SelectionChanged="NavList_SelectionChanged">
                                <ListBoxItem Content="算法管理" Tag="plugins" />
                                <ListBoxItem Content="设备管理" Tag="devices" />
                                <ListBoxItem Content="系统设置" Tag="settings" />
                            </ListBox>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
        <ContentControl x:Name="PageHost" Grid.Column="1" />
    </Grid>
</Window>
