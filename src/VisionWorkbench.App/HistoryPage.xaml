<UserControl x:Class="VisionWorkbench.App.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:VisionWorkbench.App">
    <UserControl.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource PageTextBlockBaseStyle}" />
    </UserControl.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="240" />
        </Grid.RowDefinitions>

        <!-- 筛选 -->
        <ScrollViewer Grid.Row="0" Margin="0,0,0,6"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                    <TextBlock Text="任务：" VerticalAlignment="Center" />
                    <ComboBox x:Name="TaskFilter" Width="180" DisplayMemberPath="Name" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                    <TextBlock Text="状态：" VerticalAlignment="Center" />
                    <ComboBox x:Name="StatusFilter" Width="120">
                        <ComboBoxItem Content="全部" IsSelected="True" />
                        <ComboBoxItem Content="ok" />
                        <ComboBoxItem Content="ng" />
                        <ComboBoxItem Content="review_required" />
                        <ComboBoxItem Content="processing" />
                        <ComboBoxItem Content="error" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                    <TextBlock Text="从：" VerticalAlignment="Center" />
                    <DatePicker x:Name="FromDate" Width="160" Loaded="DatePicker_Loaded"
                                PreviewMouseRightButtonDown="DatePicker_PreviewMouseRightButtonDown" />
                    <TextBlock Text="到：" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <DatePicker x:Name="ToDate" Width="160" Loaded="DatePicker_Loaded"
                                PreviewMouseRightButtonDown="DatePicker_PreviewMouseRightButtonDown" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Button Content="查询" Click="Query_Click" Margin="0,0,8,0" />
                    <Button Content="导出 CSV" Click="ExportCsv_Click" Margin="0,0,8,0" />
                    <Button x:Name="ClearAllButton" Content="清理历史记录" Click="ClearAll_Click"
                            Padding="14,4" />
                </StackPanel>
            </WrapPanel>
        </ScrollViewer>

        <DataGrid x:Name="RecordsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionChanged="RecordsGrid_SelectionChanged"
                  HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" />
                <DataGridTextColumn Header="工位" Binding="{Binding StationCode}" Width="90" />
                <DataGridTextColumn Header="项目" Binding="{Binding ProjectId}" Width="100" />
                <DataGridTextColumn Header="任务" Binding="{Binding TaskId}" Width="60" />
                <DataGridTextColumn Header="批次" Binding="{Binding BatchId}" Width="60" />
                <DataGridTextColumn Header="时间" Binding="{Binding StartedAt, StringFormat=HH:mm:ss}" Width="90" />
                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="110" />
                <DataGridTextColumn Header="算法耗时(ms)" Binding="{Binding AlgorithmElapsedMs, StringFormat=0.#}" Width="100" />
                <DataGridTextColumn Header="总耗时(ms)" Binding="{Binding TotalElapsedMs, StringFormat=0.#}" Width="90" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- 详情 + 分页 -->
        <Grid Grid.Row="2" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#111" Margin="0,0,4,0">
                <local:ImageViewer x:Name="OriginalImageViewer" Background="#111111">
                    <Grid MinWidth="1" MinHeight="1">
                        <Image x:Name="OriginalImage" Stretch="Uniform" />
                        <TextBlock Text="原图" Foreground="White" Margin="6,4" VerticalAlignment="Top" />
                    </Grid>
                </local:ImageViewer>
            </Border>
            <Border Grid.Column="1" Background="#111" Margin="0,0,4,0">
                <local:ImageViewer x:Name="ResultImageViewer" Background="#111111">
                    <Grid MinWidth="1" MinHeight="1">
                        <Image x:Name="AnnotatedImage" Stretch="Uniform" />
                        <TextBlock Text="检测结果图" Foreground="White" Margin="6,4" VerticalAlignment="Top" />
                    </Grid>
                </local:ImageViewer>
            </Border>
            <DockPanel Grid.Column="2">
                <StackPanel DockPanel.Dock="Top" Height="190">
                    <ScrollViewer Height="190"
                                  VerticalScrollBarVisibility="Visible"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False"
                                  Margin="0,8,0,0">
                        <TextBlock x:Name="DetailText" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource TextBrush}" />
                    </ScrollViewer>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
