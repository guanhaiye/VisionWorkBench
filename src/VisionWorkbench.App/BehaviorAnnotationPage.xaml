<UserControl x:Class="VisionWorkbench.App.BehaviorAnnotationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:VisionWorkbench.App">
    <Grid Margin="10">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
            <Button Content="新建行为数据集" Click="NewDataset_Click" Padding="12,5" />
            <Button Content="加载行为数据集" Click="LoadDataset_Click" Margin="6,0,0,0" Padding="12,5" />
            <Button Content="导入视频" Click="ImportVideo_Click" Margin="6,0,0,0" Padding="12,5" />
            <Button Content="导入图片序列目录" Click="BrowseFrames_Click" Margin="6,0,0,0" Padding="12,5" />
            <Button Content="保存标注" Click="SaveDataset_Click" Margin="6,0,0,0" Padding="12,5" />
            <Button Content="打开本地目录" Click="OpenDirectory_Click" Margin="6,0,0,0" Padding="12,5" />
        </WrapPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="250" /><ColumnDefinition Width="315" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <GroupBox Grid.Column="0" Header="行为数据集" Margin="0,0,8,0">
                <StackPanel Margin="8">
                    <TextBlock Text="名称" /><TextBox x:Name="DatasetNameText" Margin="0,2,0,7" />
                    <TextBlock Text="数据集目录" /><TextBox x:Name="DatasetRootText" IsReadOnly="True" TextWrapping="Wrap" Margin="0,2,0,7" />
                    <TextBlock Text="行为类别（逗号、中文逗号或换行分隔）" TextWrapping="Wrap" />
                    <TextBox x:Name="ClassesText" AcceptsReturn="True" Height="65" TextWrapping="Wrap" TextChanged="ClassesText_TextChanged" Margin="0,2,0,7" />
                    <TextBlock Text="序列长度（帧）" /><TextBox x:Name="SequenceLengthText" Text="30" Margin="0,2,0,7" />
                    <TextBlock Text="行业标准流程：视频/图片序列 → 时间片段 → 行为类别 → 视频级训练验证划分" Foreground="#666" TextWrapping="Wrap" />
                </StackPanel>
            </GroupBox>
            <Grid Grid.Column="1" Margin="0,0,8,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="序列来源" FontWeight="Bold" Margin="0,0,0,4" />
                <ComboBox x:Name="SourceCombo" Grid.Row="1" DisplayMemberPath="DisplayName" SelectionChanged="SourceCombo_SelectionChanged" Margin="0,0,0,6" />
                <ListBox x:Name="FrameList" Grid.Row="2" SelectionMode="Extended" SelectionChanged="FrameList_SelectionChanged"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
                <TextBlock Grid.Row="3" Text="已标注行为时间片段" FontWeight="Bold" Margin="0,10,0,4" />
                <ListBox x:Name="ClipList" Grid.Row="4" DisplayMemberPath="DisplayName" SelectionChanged="ClipList_SelectionChanged"
                         PreviewMouseRightButtonDown="ClipList_PreviewMouseRightButtonDown"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="&#x5220;&#x9664;&#x5F53;&#x524D;&#x7247;&#x6BB5;" Click="DeleteClipContextMenu_Click" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </Grid>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="180" /></Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="时间轴" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Slider x:Name="TimelineSlider" Grid.Column="1" Minimum="0" Maximum="1" ValueChanged="TimelineSlider_ValueChanged" />
                    <TextBlock x:Name="CurrentFrameText" Grid.Column="2" Text="0/0" VerticalAlignment="Center" Margin="8,0,0,0" />
                </Grid>
                <local:ImageViewer Grid.Row="1" Background="#202020" BorderBrush="#888" BorderThickness="1">
                    <Image x:Name="PreviewImage" Stretch="Uniform" />
                </local:ImageViewer>
                <StackPanel Grid.Row="2" Margin="0,8,0,0">
                    <WrapPanel>
                        <TextBlock Text="片段起始帧" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBox x:Name="StartFrameText" Width="65" Text="0" />
                        <Button Content="设为当前帧" Click="SetStartFrame_Click" Margin="4,0,8,0" />
                        <TextBlock Text="结束帧" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBox x:Name="EndFrameText" Width="65" Text="0" />
                        <Button Content="设为当前帧" Click="SetEndFrame_Click" Margin="4,0,0,0" />
                    </WrapPanel>
                    <WrapPanel Margin="0,6,0,0">
                        <TextBlock Text="行为类别" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox x:Name="LabelCombo" Width="170" IsEditable="True" />
                        <Button Content="保存时间片段" Click="SaveClip_Click" Margin="8,0,0,0" Padding="10,4" />
                        <Button Content="删除片段" Click="DeleteClip_Click" Margin="6,0,0,0" Padding="10,4" />
                    </WrapPanel>
                </StackPanel>
                <TextBox x:Name="ClipInfoText" Grid.Row="3" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" Margin="0,8,0,0" />
            </Grid>
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="2" Foreground="DarkGreen" Margin="0,8,0,0" TextWrapping="Wrap" />
    </Grid>
</UserControl>
