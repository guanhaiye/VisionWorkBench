<UserControl x:Class="VisionWorkbench.App.SpcPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="SPC 检测结果图" FontSize="24" FontWeight="Bold" Margin="0,0,0,8" />

        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="任务：" VerticalAlignment="Center" />
            <ComboBox x:Name="TaskFilter" Width="190" DisplayMemberPath="Name" Margin="6,0,0,0" />
            <TextBlock Text="状态：" VerticalAlignment="Center" Margin="14,0,0,0" />
            <ComboBox x:Name="StatusFilter" Width="150" Margin="6,0,0,0">
                <ComboBoxItem Content="全部记录" Tag="all" />
                <ComboBoxItem Content="NG / 待确认" Tag="evidence" IsSelected="True" />
                <ComboBoxItem Content="NG" Tag="ng" />
                <ComboBoxItem Content="待确认" Tag="review_required" />
                <ComboBoxItem Content="OK" Tag="ok" />
            </ComboBox>
            <TextBlock Text="从：" VerticalAlignment="Center" Margin="14,0,0,0" />
            <DatePicker x:Name="FromDate" Width="130" Margin="6,0,0,0" />
            <TextBlock Text="到：" VerticalAlignment="Center" Margin="8,0,0,0" />
            <DatePicker x:Name="ToDate" Width="130" Margin="6,0,0,0" />
            <Button Content="查询" Click="Query_Click" Margin="14,0,0,0" Padding="14,3" />
            <Button Content="删除当前记录" Click="Delete_Click" Margin="8,0,0,0" Padding="14,3" />
            <TextBlock x:Name="SummaryText" Text="等待查询" VerticalAlignment="Center" Foreground="#555" Margin="14,0,0,0" />
        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="RecordsGrid" Grid.Column="0" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionChanged="RecordsGrid_SelectionChanged"
                      PreviewMouseRightButtonDown="RecordsGrid_PreviewMouseRightButtonDown"
                      HeadersVisibility="Column">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="删除当前记录" Click="Delete_Click" />
                        <Separator />
                        <MenuItem Header="清除全部检测记录" Click="ClearAll_Click" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="时间" Binding="{Binding StartedAt, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="150" />
                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="92" />
                    <DataGridTextColumn Header="工位" Binding="{Binding StationCode}" Width="78" />
                    <DataGridTextColumn Header="耗时(ms)" Binding="{Binding TotalElapsedMs, StringFormat=0.#}" Width="82" />
                    <DataGridCheckBoxColumn Header="图" Binding="{Binding HasEvidenceImage, Mode=OneWay}" Width="42" />
                </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Column="1" Margin="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="210" />
                </Grid.RowDefinitions>
                <GroupBox Grid.Row="0" Header="检测结果图（标注图）">
                    <Border Background="#111111">
                        <Image x:Name="AnnotatedImage" Stretch="Uniform" />
                    </Border>
                </GroupBox>
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>
                    <GroupBox Grid.Column="0" Header="原图">
                        <Border Background="#111111">
                            <Image x:Name="OriginalImage" Stretch="Uniform" />
                        </Border>
                    </GroupBox>
                    <GroupBox Grid.Column="1" Header="记录详情" Margin="8,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="DetailText" TextWrapping="Wrap" Margin="6" Foreground="#444" />
                        </ScrollViewer>
                    </GroupBox>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
