<UserControl x:Class="VisionWorkbench.App.LivePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="Page_Loaded"
             Unloaded="Page_Unloaded">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="实时检测任务工作区：" VerticalAlignment="Center" />
            <Button Content="添加任务" Click="AddTask_Click" Margin="8,0,0,0" Padding="14,4" />
            <Button Content="刷新任务" Click="RefreshTasks_Click" Margin="8,0,0,0" Padding="14,4" />
            <TextBlock Text="窗口布局：" VerticalAlignment="Center" Margin="24,0,4,0" />
            <ComboBox x:Name="LayoutCombo" Width="110" SelectionChanged="LayoutCombo_SelectionChanged">
                <ComboBoxItem Content="田字格" Tag="grid" />
                <ComboBoxItem Content="纵向排列" Tag="vertical" />
                <ComboBoxItem Content="横向排列" Tag="horizontal" />
            </ComboBox>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="0,1,0,1" Padding="6" Margin="0,0,0,8">
            <TextBlock x:Name="WorkspaceStatusText" Text="请选择任务并点击“添加任务”。每个任务拥有独立的预览、结果和控制按钮。" Foreground="#555" />
        </Border>

        <ScrollViewer Grid.Row="2"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="PanelsHost" />
        </ScrollViewer>

        <!-- 保留 UI 冒烟测试所需的兼容性画布；实际显示由上面的任务面板负责。 -->
        <Grid Grid.Row="2" Opacity="0" IsHitTestVisible="False">
            <Image x:Name="PreviewImage" Stretch="Uniform" />
            <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False" />
            <TextBlock x:Name="VisibleText" />
            <TextBlock x:Name="TotalText" />
            <TextBlock x:Name="ForwardText" />
            <TextBlock x:Name="ReverseText" />
        </Grid>

        <Border Grid.Row="3" BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="4" Margin="0,8,0,0">
            <TextBlock Text="每个任务的检测状态、算法耗时和计数结果在对应面板内独立显示。" Foreground="#666" />
        </Border>
    </Grid>
</UserControl>
