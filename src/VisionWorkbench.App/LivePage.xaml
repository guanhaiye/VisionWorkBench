<UserControl x:Class="VisionWorkbench.App.LivePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:VisionWorkbench.App"
             Loaded="Page_Loaded"
             Unloaded="Page_Unloaded">
    <UserControl.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource PageTextBlockBaseStyle}" />
    </UserControl.Resources>
    <Grid Margin="8" TextElement.Foreground="{DynamicResource TextBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="实时检测任务工作区" VerticalAlignment="Center" />
            <Button x:Name="WorkspaceSettingsButton" Content="设置" Click="WorkspaceSettings_Click"
                    HorizontalAlignment="Right" Padding="14,4" />
            <Popup x:Name="WorkspaceSettingsPopup"
                   PlacementTarget="{Binding ElementName=WorkspaceSettingsButton}"
                   Placement="Bottom"
                   HorizontalOffset="0"
                   VerticalOffset="6"
                   StaysOpen="False"
                   AllowsTransparency="True"
                   PopupAnimation="Fade">
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Width="320">
                    <StackPanel>
                        <TextBlock Text="工作区设置" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="添加任务" Click="AddTask_Click" Padding="14,4" />
                            <Button Content="刷新任务" Click="RefreshTasks_Click" Padding="14,4" />
                        </StackPanel>
                        <TextBlock Text="删除任务" Margin="4,10,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="DeleteTaskCombo"
                                      MinWidth="190"
                                      ItemsSource="{Binding}"
                                      ToolTip="选择要永久删除的任务" />
                            <Button Grid.Column="1"
                                    Content="删除"
                                    Click="DeleteTask_Click"
                                    Margin="8,0,0,0"
                                    Padding="14,4" />
                        </Grid>
                        <TextBlock Text="窗口布局" Margin="4,10,0,4" />
                        <ComboBox x:Name="LayoutCombo" SelectionChanged="LayoutCombo_SelectionChanged">
                            <ComboBoxItem Content="田字格" Tag="grid" />
                            <ComboBoxItem Content="纵向排列" Tag="vertical" />
                            <ComboBoxItem Content="横向排列" Tag="horizontal" />
                        </ComboBox>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>

        <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="0,1,0,1" Padding="6" Margin="0,0,0,8">
            <TextBlock x:Name="WorkspaceStatusText" Text="请选择任务并点击“添加任务”。每个任务拥有独立的预览、结果和控制按钮。" Foreground="#555" />
        </Border>

        <Grid x:Name="PanelsViewport" Grid.Row="2"
              SizeChanged="PanelsViewport_SizeChanged"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <ItemsControl x:Name="PanelsHost"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          VerticalContentAlignment="Stretch">
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="{x:Type local:LiveTaskPanel}">
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="VerticalAlignment" Value="Stretch" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>
        </Grid>

        <!-- 保留 UI 冒烟测试所需的兼容性画布；实际显示由上面的任务面板负责。 -->
        <Grid Grid.Row="2" Opacity="0" IsHitTestVisible="False">
            <Image x:Name="PreviewImage" Stretch="Uniform" />
            <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False" />
            <TextBlock x:Name="VisibleText" />
            <TextBlock x:Name="TotalText" />
            <TextBlock x:Name="ForwardText" />
            <TextBlock x:Name="ReverseText" />
        </Grid>

        <Border Grid.Row="3" BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="4" Margin="0,8,0,0">
            <TextBlock Text="每个任务的检测状态、算法耗时和计数结果在对应面板内独立显示。" Foreground="#666" />
        </Border>
    </Grid>
</UserControl>
