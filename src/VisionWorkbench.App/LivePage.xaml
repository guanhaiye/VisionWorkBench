<UserControl x:Class="VisionWorkbench.App.LivePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶栏：任务选择与控制 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="任务：" VerticalAlignment="Center" />
            <ComboBox x:Name="TaskCombo" Width="240" DisplayMemberPath="Name" />
            <Button x:Name="StartButton" Content="开始" Click="Start_Click" Margin="16,0,0,0" />
            <Button x:Name="PauseButton" Content="暂停" Click="Pause_Click" IsEnabled="False" />
            <Button x:Name="SingleButton" Content="单次检测" Click="Single_Click" IsEnabled="False" />
            <Button x:Name="StopButton" Content="结束批次" Click="Stop_Click" IsEnabled="False" />
            <Button x:Name="AdjustButton" Content="人工修正" Click="Adjust_Click" IsEnabled="False" />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- 预览 + 叠加层（归一化坐标 → 像素） -->
            <Border Grid.Column="0" Background="#111111" MinHeight="360">
                <Grid>
                    <Image x:Name="PreviewImage" Stretch="Uniform" />
                    <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False" />
                </Grid>
            </Border>

            <!-- 结果面板 -->
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <GroupBox Header="当前判定">
                    <StackPanel>
                        <TextBlock x:Name="DecisionText" Text="—" FontSize="34" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,8" />
                        <TextBlock x:Name="SummaryText" TextWrapping="Wrap" FontSize="12" Foreground="#666"
                                   Margin="4,0,4,8" />
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="检测结果">
                    <StackPanel>
                        <TextBlock x:Name="CountText" Text="数量: —" FontSize="18" Margin="0,4" />
                        <TextBlock x:Name="ElapsedText" Text="算法耗时: —" Margin="0,2" />
                        <TextBlock x:Name="DetectionListText" TextWrapping="Wrap" FontSize="11" Foreground="#555"
                                   MaxHeight="120" />
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="累计">
                    <StackPanel>
                        <TextBlock x:Name="TotalText" Text="累计: 0" FontSize="22" Margin="0,4" />
                        <TextBlock x:Name="BatchText" Text="批次: —" Margin="0,2" />
                        <TextBlock x:Name="RecordStatsText" Text="OK 0 / NG 0 / 待确认 0" Margin="0,2" />
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="NG / 待确认 证据图">
                    <Image x:Name="EvidenceImage" Stretch="Uniform" MaxHeight="160" />
                </GroupBox>
            </StackPanel>
        </Grid>

        <!-- 状态栏：相机FPS | 算法FPS | 后端 | 数据库 -->
        <Border Grid.Row="2" BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="4" Margin="0,8,0,0">
            <TextBlock x:Name="StatusText" Text="相机 FPS: 0 | 算法 FPS: 0 | 后端: cpu | 数据库: 未连接" />
        </Border>
    </Grid>
</UserControl>
