<UserControl x:Class="VisionWorkbench.App.LivePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:VisionWorkbench.App"
             Loaded="Page_Loaded"
             Unloaded="Page_Unloaded">
    <UserControl.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource PageTextBlockBaseStyle}" />
    </UserControl.Resources>
    <Grid Margin="8" TextElement.Foreground="{DynamicResource TextBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="实时检测任务工作区" VerticalAlignment="Center" />
            <Button x:Name="WorkspaceSettingsButton" Content="设置" Click="WorkspaceSettings_Click"
                    HorizontalAlignment="Right" Padding="14,4" />
            <Popup x:Name="WorkspaceSettingsPopup"
                   PlacementTarget="{Binding ElementName=WorkspaceSettingsButton}"
                   Placement="Bottom"
                   HorizontalOffset="0"
                   VerticalOffset="6"
                   StaysOpen="False"
                   AllowsTransparency="True"
                   PopupAnimation="Fade">
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16"
                        Width="360">
                    <StackPanel>
                        <TextBlock Text="工作区设置" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="管理检测面板、显示方式和任务。"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,3,0,14" />

                        <TextBlock Text="任务面板" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Content="添加任务" Click="AddTask_Click" Padding="14,5" Margin="0,0,4,0" />
                            <Button Grid.Column="1" Content="刷新任务" Click="RefreshTasks_Click"
                                    Padding="14,5" Margin="4,0,0,0" />
                        </Grid>

                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,14,0,12" />
                        <TextBlock Text="显示模式" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <Button x:Name="RuntimeModeButton"
                                Content="进入运行模式"
                                Click="RuntimeMode_Click"
                                Padding="14,6"
                                HorizontalContentAlignment="Center" />
                        <TextBlock Text="运行模式会隐藏左侧工具栏，扩大检测画面。"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="11" Margin="2,5,0,10" />
                        <TextBlock Text="窗口布局" Margin="0,0,0,5" />
                        <ComboBox x:Name="LayoutCombo" SelectionChanged="LayoutCombo_SelectionChanged">
                            <ComboBoxItem Content="田字格" Tag="grid" />
                            <ComboBoxItem Content="纵向排列" Tag="vertical" />
                            <ComboBoxItem Content="横向排列" Tag="horizontal" />
                        </ComboBox>

                    </StackPanel>
                </Border>
            </Popup>
        </Grid>

        <Border Grid.Row="0"
                VerticalAlignment="Bottom"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                IsHitTestVisible="False" />

        <!-- 工作区状态通过操作提示和对话框反馈，不再占用顶部独立状态栏。 -->
        <TextBlock x:Name="WorkspaceStatusText"
                   Grid.Row="1"
                   Visibility="Collapsed"
                   Text="请选择任务并点击“添加任务”。每个任务拥有独立的预览、结果和控制按钮。" />
        <Border x:Name="TcpOfflineActivityPanel"
                Grid.Row="1"
                Visibility="Collapsed"
                Margin="0,0,0,8"
                Padding="8,6"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <StackPanel>
                <TextBlock Text="TCP 离线检测请求（每个请求独立执行）"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4" />
                <ScrollViewer MaxHeight="92" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="TcpOfflineActivityItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <Grid x:Name="PanelsViewport" Grid.Row="2"
              SizeChanged="PanelsViewport_SizeChanged"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              ClipToBounds="True">
            <ItemsControl x:Name="PanelsHost"
                          Width="{Binding ActualWidth, ElementName=PanelsViewport}"
                          Height="{Binding ActualHeight, ElementName=PanelsViewport}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          VerticalContentAlignment="Stretch">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- 统一使用同一个可配置的网格容器，避免 ItemsControl 默认的纵向 StackPanel 覆盖“田字格”设置。 -->
                        <UniformGrid />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="{x:Type local:LiveTaskPanel}">
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="VerticalAlignment" Value="Stretch" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>
        </Grid>

        <!-- 保留 UI 冒烟测试所需的兼容性画布；实际显示由上面的任务面板负责。 -->
        <Grid Grid.Row="2" Opacity="0" IsHitTestVisible="False">
            <Image x:Name="PreviewImage" Stretch="Uniform" />
            <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False" />
            <TextBlock x:Name="VisibleText" />
            <TextBlock x:Name="TotalText" />
            <TextBlock x:Name="ForwardText" />
            <TextBlock x:Name="ReverseText" />
        </Grid>

    </Grid>
</UserControl>
