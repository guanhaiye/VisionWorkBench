<Window x:Class="VisionWorkbench.App.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="430" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True"
        ShowInTaskbar="False" ResizeMode="NoResize"
        Background="Transparent"
        Title="确认">
    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="6" Direction="270"
                              Opacity="0.18" Color="#334155"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Border Width="4" Height="22" Background="{DynamicResource AccentBrush}"
                        CornerRadius="2" Margin="0,0,10,0"/>
                <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"/>
            </StackPanel>

            <TextBlock x:Name="MessageText" Grid.Row="1" Margin="14,16,0,20"
                       TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                       LineHeight="22"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="取消" IsCancel="True"
                        Style="{StaticResource SecondaryButton}" Click="Cancel_Click"/>
                <Button x:Name="ConfirmButton" Content="确定" IsDefault="True"
                        Click="Confirm_Click" Margin="8,2,4,2"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
