<Window x:Class="VisionWorkbench.App.DatasetRenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="修改数据集名称"
        Width="360"
        Height="150"
        Style="{StaticResource ThemedDialogWindow}"
        WindowStartupLocation="CenterOwner">
    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="6" Direction="270"
                              Opacity="0.18" Color="#334155" />
        </Border.Effect>
        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBox x:Name="NameText" Grid.Row="0" Margin="0,0,0,12" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="确定" Click="Confirm_Click" Width="76" Margin="0,0,8,0" />
            <Button Content="取消" Click="Cancel_Click" Width="76" />
        </StackPanel>
        </Grid>
    </Border>
</Window>
