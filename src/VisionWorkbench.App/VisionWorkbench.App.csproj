<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>VisionWorkbench.App</RootNamespace>
    <Description>VisionWorkbench 主程序（WPF）</Description>
    <AssemblyName>VisionWorkbench</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Resource Include="..\..\assets\branding\visionworkbench-logo-v1.png">
      <Link>Assets\Branding\visionworkbench-logo-v1.png</Link>
    </Resource>
    <ApplicationIcon Include="..\..\assets\branding\visionworkbench-logo-v1.ico">
      <Link>Assets\Branding\visionworkbench-logo-v1.ico</Link>
    </ApplicationIcon>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\VisionWorkbench.Application\VisionWorkbench.Application.csproj" />
    <ProjectReference Include="..\VisionWorkbench.Cameras.Files\VisionWorkbench.Cameras.Files.csproj" />
    <ProjectReference Include="..\VisionWorkbench.Cameras.Usb\VisionWorkbench.Cameras.Usb.csproj" />
  </ItemGroup>
</Project>
