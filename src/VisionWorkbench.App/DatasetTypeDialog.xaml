<Window x:Class="VisionWorkbench.App.DatasetTypeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择数据集类型"
        Width="380"
        Height="270"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock Text="请选择标注任务类型" FontSize="18" FontWeight="Bold" />
        <TextBlock Text="类型确定后，标注形状和智能标注工具会自动匹配。"
                   Margin="0,8,0,14"
                   Foreground="#666"
                   TextWrapping="Wrap" />
        <Button Content="目标检测"
                Tag="detection"
                Click="TaskType_Click"
                Height="32"
                Margin="0,0,0,8" />
        <Button Content="语义分割"
                Tag="semantic_segmentation"
                Click="TaskType_Click"
                Height="32"
                Margin="0,0,0,8" />
        <Button Content="实例分割"
                Tag="instance_segmentation"
                Click="TaskType_Click"
                Height="32" />
    </StackPanel>
</Window>
