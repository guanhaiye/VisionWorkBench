<Window x:Class="VisionWorkbench.App.DatasetTypeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择数据集类型"
        Width="380"
        Height="270"
        Style="{StaticResource ThemedDialogWindow}"
        WindowStartupLocation="CenterOwner">
    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="6" Direction="270"
                              Opacity="0.18" Color="#334155" />
        </Border.Effect>
        <StackPanel>
        <TextBlock Text="请选择标注任务类型" FontSize="18" FontWeight="Bold" />
        <TextBlock Text="类型确定后，标注形状和智能标注工具会自动匹配。"
                   Margin="0,8,0,14"
                   Foreground="#666"
                   TextWrapping="Wrap" />
        <Button x:Name="DetectionButton"
                Content="目标检测"
                Tag="detection"
                Click="TaskType_Click"
                Height="32"
                Margin="0,0,0,8" />
        <Button x:Name="SemanticButton"
                Content="语义分割"
                Tag="semantic_segmentation"
                Click="TaskType_Click"
                Height="32"
                Margin="0,0,0,8" />
        <Button x:Name="InstanceButton"
                Content="实例分割（YOLO11-seg）"
                Tag="instance_segmentation"
                Click="TaskType_Click"
                Height="32" />
        </StackPanel>
    </Border>
</Window>
